{
    "name": "anthonyiles/worktree-isolation",
    "description": "Per-worktree test database isolation and bootstrap automation for PHP projects.",
    "keywords": ["worktree", "testing", "isolation", "docker", "docker-compose", "laravel", "herd", "valet", "phpunit"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "illuminate/support": "^11.0|^12.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "suggest": {
        "illuminate/support": "Required for artisan commands (worktree:install, worktree:clean). Not needed if using the standalone vendor/bin/ scripts."
    },
    "autoload": {
        "psr-4": {
            "WorktreeIsolation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WorktreeIsolation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "bin": [
        "stubs/bin/worktree-install",
        "stubs/bin/worktree-setup",
        "stubs/bin/test",
        "stubs/bin/worktree-clean"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "WorktreeIsolation\\WorktreeIsolationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
