{
    "name": "laravel-worktree-isolation/laravel-worktree-isolation",
    "description": "Per-worktree test database isolation and bootstrap automation for Laravel Sail projects.",
    "keywords": ["laravel", "worktree", "testing", "isolation", "sail", "docker"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "WorktreeIsolation\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WorktreeIsolation\\WorktreeIsolationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
