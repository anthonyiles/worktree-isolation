# Worktree Isolation — Makefile targets
# Include this in your project Makefile or copy the targets directly.
#
# Usage:
#   make setup-worktree-hooks   — Enable git hooks + make scripts executable
#   make clean-test-dbs         — Drop all per-worktree test databases (testing-*)

.PHONY: setup-worktree-hooks clean-test-dbs

setup-worktree-hooks:
	@echo "Setting up worktree hooks..."
	@GIT_VERSION=$$(git --version | grep -oE '[0-9]+\.[0-9]+' | head -1); \
	if [ "$$(printf '%s\n' "2.54" "$$GIT_VERSION" | sort -V | head -n1)" != "2.54" ]; then \
		echo ""; \
		echo "Error: Git 2.54+ is required. You have Git $$GIT_VERSION."; \
		echo "Please upgrade: brew upgrade git"; \
		echo ""; \
		exit 1; \
	fi
	@chmod +x .githooks/*.sh bin/worktree-setup bin/test
	@git config --local include.path ../.githooks.config
	@echo "Git hooks configured successfully!"
	@echo ""
	@echo "Configured hooks:"
	@git hook list pre-commit 2>/dev/null || true
	@git hook list commit-msg 2>/dev/null || true
	@git hook list post-checkout 2>/dev/null || true

clean-test-dbs:
	@echo "Dropping all 'testing-*' databases..."
	@vendor/bin/sail exec -T mysql mysql -u root -N -e \
		"SELECT CONCAT('DROP DATABASE \`', schema_name, '\`;') FROM information_schema.schemata WHERE schema_name LIKE 'testing-%'" \
		| vendor/bin/sail exec -T mysql mysql -u root -v
	@echo "Done."
