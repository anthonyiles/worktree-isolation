#!/usr/bin/env bash
#
# Runs tests with per-worktree database isolation.
#
# Supports three runtime drivers (set WORKTREE_RUNTIME in .worktree-isolation.env):
#   native         — runs test command directly on the host
#   docker-compose — runs via `docker compose exec` in a running service container
#   docker-image   — runs via `docker run` with a standalone image (mounts project)
#
# The test command defaults to `php artisan test` but can be overridden via
# WORKTREE_TEST_COMMAND in .worktree-isolation.env (e.g. `php vendor/bin/phpunit`).
#
# Usage:
#   vendor/bin/worktree test                        # run all tests
#   vendor/bin/worktree test --filter=testName      # forward args to test runner
#   vendor/bin/worktree test tests/Feature/MyTest.php
#
# Invoked as `vendor/bin/worktree test` (stubs/bin/worktree dispatches
# straight into this file); not itself exposed as a Composer bin.
set -euo pipefail

# This file can still be invoked through a symlink (bats tests do this), so
# keep resolving one defensively even though vendor/bin/worktree calls it by
# a direct, non-symlinked path. readlink -f isn't portable (no -f on macOS's
# stock readlink), so resolve it manually.
resolve_script_dir() {
    local src="${BASH_SOURCE[0]}"
    while [[ -h "$src" ]]; do
        local dir
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(resolve_script_dir)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_worktree-lib.sh"

# ---------------------------------------------------------------------------
# 0. Load configuration
# ---------------------------------------------------------------------------
load_worktree_config
TEST_COMMAND="${WORKTREE_TEST_COMMAND:-php artisan test}"

# ---------------------------------------------------------------------------
# 1. Validate runtime
# ---------------------------------------------------------------------------
validate_runtime

# ---------------------------------------------------------------------------
# 2. Load testing env vars
# ---------------------------------------------------------------------------
if [[ -f "$PROJECT_ROOT/$TESTING_ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$PROJECT_ROOT/$TESTING_ENV_FILE"
    set +a
fi

# ---------------------------------------------------------------------------
# 3. Inline PHP that derives and creates the per-worktree database.
# ---------------------------------------------------------------------------
# The autoload path placeholder is replaced per-driver.
DB_ENSURE_PHP='
    require "__AUTOLOAD__";
    $class = getenv("RESOLVER_CLASS") ?: "WorktreeIsolation\\TestDatabaseResolver";
    $base  = getenv("DB_DATABASE") ?: "testing";
    $wt    = getenv("WORKTREE_BASENAME") ?: "worktree";
    $name  = $class::derive($base, $wt);
    $class::ensureExists(
        $name,
        getenv("DB_HOST") ?: "127.0.0.1",
        (int)(getenv("DB_PORT") ?: 3306),
        getenv("DB_USERNAME") ?: "",
        getenv("DB_PASSWORD") ?: "",
    );
    echo "Using test database: $name\n";
    file_put_contents("/tmp/.test_db_name", $name);
'

# ---------------------------------------------------------------------------
# 4. Run tests
# ---------------------------------------------------------------------------
if [[ "${!DB_PER_WORKTREE_KEY:-}" =~ ^(true|1)$ ]]; then
    case "$RUNTIME" in
        native)
            RESOLVER_CLASS="$RESOLVER_CLASS" \
            WORKTREE_BASENAME="$WORKTREE_BASENAME" \
                php -r "${DB_ENSURE_PHP//__AUTOLOAD__/$PROJECT_ROOT/vendor/autoload.php}"

            export DB_DATABASE
            DB_DATABASE="$(cat /tmp/.test_db_name)"
            $TEST_COMMAND "$@"
            ;;

        docker-compose)
            "${COMPOSE_ARGS[@]}" exec -T \
                -e "RESOLVER_CLASS=$RESOLVER_CLASS" \
                -e "WORKTREE_BASENAME=$WORKTREE_BASENAME" \
                -e "TEST_COMMAND=$TEST_COMMAND" \
                -e "DB_DATABASE=${DB_DATABASE:-}" \
                -e "DB_HOST=${DB_HOST:-}" \
                -e "DB_PORT=${DB_PORT:-}" \
                -e "DB_USERNAME=${DB_USERNAME:-}" \
                -e "DB_PASSWORD=${DB_PASSWORD:-}" \
                "$COMPOSE_SERVICE" \
                bash -c '
                    php -r '"'"'
                        require "vendor/autoload.php";
                        $class = getenv("RESOLVER_CLASS") ?: "WorktreeIsolation\\TestDatabaseResolver";
                        $base  = getenv("DB_DATABASE") ?: "testing";
                        $wt    = getenv("WORKTREE_BASENAME") ?: "worktree";
                        $name  = $class::derive($base, $wt);
                        $class::ensureExists(
                            $name,
                            getenv("DB_HOST") ?: "127.0.0.1",
                            (int)(getenv("DB_PORT") ?: 3306),
                            getenv("DB_USERNAME") ?: "",
                            getenv("DB_PASSWORD") ?: "",
                        );
                        echo "Using test database: $name\n";
                        file_put_contents("/tmp/.test_db_name", $name);
                    '"'"' && \
                    export DB_DATABASE="$(cat /tmp/.test_db_name)" && \
                    $TEST_COMMAND "$@"
                ' -- "$@"
            ;;

        docker-image)
            build_docker_image_args
            forward_testing_env_vars
            DOCKER_ARGS+=(-e "WORKTREE_BASENAME=$WORKTREE_BASENAME")
            DOCKER_ARGS+=(-e "TEST_COMMAND=$TEST_COMMAND")

            exec "${DOCKER_ARGS[@]}" --entrypoint bash "$IMAGE" -c '
                php -r '"'"'
                    require "vendor/autoload.php";
                    $class = getenv("RESOLVER_CLASS") ?: "WorktreeIsolation\\TestDatabaseResolver";
                    $base  = getenv("DB_DATABASE") ?: "testing";
                    $wt    = getenv("WORKTREE_BASENAME") ?: "worktree";
                    $name  = $class::derive($base, $wt);
                    $class::ensureExists(
                        $name,
                        getenv("DB_HOST") ?: "127.0.0.1",
                        (int)(getenv("DB_PORT") ?: 3306),
                        getenv("DB_USERNAME") ?: "",
                        getenv("DB_PASSWORD") ?: "",
                    );
                    echo "Using test database: $name\n";
                    file_put_contents("/tmp/.test_db_name", $name);
                '"'"' && \
                export DB_DATABASE="$(cat /tmp/.test_db_name)" && \
                $TEST_COMMAND "$@"
            ' -- "$@"
            ;;
    esac
else
    # No per-worktree DB — just run tests directly
    case "$RUNTIME" in
        native)
            $TEST_COMMAND "$@"
            ;;
        docker-compose)
            "${COMPOSE_ARGS[@]}" exec -T \
                -e "TEST_COMMAND=$TEST_COMMAND" \
                "$COMPOSE_SERVICE" \
                bash -c '$TEST_COMMAND "$@"' -- "$@"
            ;;
        docker-image)
            build_docker_image_args
            forward_testing_env_vars
            DOCKER_ARGS+=(-e "TEST_COMMAND=$TEST_COMMAND")
            exec "${DOCKER_ARGS[@]}" --entrypoint bash "$IMAGE" -c '$TEST_COMMAND "$@"' -- "$@"
            ;;
    esac
fi
