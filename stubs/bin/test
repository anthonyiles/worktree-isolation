#!/usr/bin/env bash
#
# Runs tests with per-worktree database isolation.
#
# Supports three runtime drivers (set WORKTREE_RUNTIME in .worktree-isolation.env):
#   native         — runs test command directly on the host
#   docker-compose — runs via `docker compose exec` in a running service container
#   docker-image   — runs via `docker run` with a standalone image (mounts project)
#
# The test command defaults to `php artisan test` but can be overridden via
# WORKTREE_TEST_COMMAND in .worktree-isolation.env (e.g. `php vendor/bin/phpunit`).
#
# Usage:
#   vendor/bin/test                        # run all tests
#   vendor/bin/test --filter=testName      # forward args to test runner
#   vendor/bin/test tests/Feature/MyTest.php
#
set -euo pipefail

# vendor/bin/test is a Composer-managed symlink, not the project root —
# resolve via git instead.
PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# ---------------------------------------------------------------------------
# 0. Load configuration
# ---------------------------------------------------------------------------
CONF_FILE="$PROJECT_ROOT/.worktree-isolation.env"
if [[ -f "$CONF_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$CONF_FILE"
    set +a
fi

RUNTIME="${WORKTREE_RUNTIME:-native}"
TEST_COMMAND="${WORKTREE_TEST_COMMAND:-php artisan test}"
TESTING_ENV_FILE="${WORKTREE_TESTING_ENV_FILE:-.env.testing}"
DB_PER_WORKTREE_KEY="${WORKTREE_DB_PER_WORKTREE_KEY:-TEST_DB_PER_WORKTREE}"
RESOLVER_CLASS="${WORKTREE_RESOLVER_CLASS:-WorktreeIsolation\\TestDatabaseResolver}"

# docker-image driver settings
IMAGE="${WORKTREE_DOCKER_IMAGE:-}"
NETWORK="${WORKTREE_DOCKER_NETWORK:-}"
WORKDIR="${WORKTREE_DOCKER_WORKDIR:-/var/www/html}"

# docker-compose driver settings
COMPOSE_SERVICE="${WORKTREE_COMPOSE_SERVICE:-app}"
COMPOSE_FILE_OPT=""
if [[ -n "${WORKTREE_COMPOSE_FILE:-}" ]]; then
    COMPOSE_FILE_OPT="-f $WORKTREE_COMPOSE_FILE"
fi

# ---------------------------------------------------------------------------
# 1. Validate runtime
# ---------------------------------------------------------------------------
case "$RUNTIME" in
    native)
        ;;
    docker-compose)
        if ! docker compose version > /dev/null 2>&1; then
            echo "Error: 'docker compose' not found. Install Docker with the Compose plugin." >&2
            exit 1
        fi
        ;;
    docker-image)
        if [[ -z "$IMAGE" ]]; then
            echo "Error: WORKTREE_DOCKER_IMAGE must be set for the docker-image runtime." >&2
            exit 1
        fi
        if ! docker image inspect "$IMAGE" > /dev/null 2>&1; then
            echo "Error: Docker image '$IMAGE' not found." >&2
            echo "Build it first (e.g. 'docker compose build' or 'vendor/bin/sail build')." >&2
            exit 1
        fi
        ;;
    *)
        echo "Error: Unknown WORKTREE_RUNTIME '$RUNTIME'. Use: native, docker-compose, or docker-image." >&2
        exit 1
        ;;
esac

# ---------------------------------------------------------------------------
# 2. Load testing env vars
# ---------------------------------------------------------------------------
if [[ -f "$PROJECT_ROOT/$TESTING_ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$PROJECT_ROOT/$TESTING_ENV_FILE"
    set +a
fi

# ---------------------------------------------------------------------------
# 3. Helper: build docker-image base args
# ---------------------------------------------------------------------------
build_docker_image_args() {
    DOCKER_ARGS=(
        docker run --rm
        -v "$PROJECT_ROOT:$WORKDIR"
        -w "$WORKDIR"
    )

    if [[ -n "$NETWORK" ]]; then
        DOCKER_ARGS+=(--network "$NETWORK")
    fi

    local DEFAULT_ENV_VARS=(
        APP_ENV APP_KEY APP_DEBUG
        DB_CONNECTION DB_HOST DB_PORT DB_DATABASE DB_USERNAME DB_PASSWORD DB_SSL_VERIFY_SERVER_CERT
        BCRYPT_ROUNDS CACHE_DRIVER MAIL_MAILER QUEUE_CONNECTION SESSION_DRIVER
        TELESCOPE_ENABLED
        "$DB_PER_WORKTREE_KEY"
    )

    local EXTRA_VARS
    IFS=' ' read -ra EXTRA_VARS <<< "${WORKTREE_EXTRA_ENV_VARS:-}"
    local ENV_VARS=("${DEFAULT_ENV_VARS[@]}" "${EXTRA_VARS[@]}")

    for var in "${ENV_VARS[@]}"; do
        if [[ -n "${!var:-}" ]]; then
            DOCKER_ARGS+=(-e "$var=${!var}")
        fi
    done
}

# Inline PHP that derives and creates the per-worktree database.
# The autoload path placeholder is replaced per-driver.
DB_ENSURE_PHP='
    require "__AUTOLOAD__";
    $class = getenv("RESOLVER_CLASS") ?: "WorktreeIsolation\\TestDatabaseResolver";
    $base  = getenv("DB_DATABASE") ?: "testing";
    $wt    = getenv("WORKTREE_BASENAME") ?: "worktree";
    $name  = $class::derive($base, $wt);
    $class::ensureExists(
        $name,
        getenv("DB_HOST") ?: "127.0.0.1",
        (int)(getenv("DB_PORT") ?: 3306),
        getenv("DB_USERNAME") ?: "",
        getenv("DB_PASSWORD") ?: "",
    );
    echo "Using test database: $name\n";
    file_put_contents("/tmp/.test_db_name", $name);
'

# ---------------------------------------------------------------------------
# 4. Run tests
# ---------------------------------------------------------------------------
if [[ "${!DB_PER_WORKTREE_KEY:-}" =~ ^(true|1)$ ]]; then
    WORKTREE_BASENAME="$(basename "$PROJECT_ROOT")"

    case "$RUNTIME" in
        native)
            RESOLVER_CLASS="$RESOLVER_CLASS" \
            WORKTREE_BASENAME="$WORKTREE_BASENAME" \
                php -r "${DB_ENSURE_PHP//__AUTOLOAD__/$PROJECT_ROOT/vendor/autoload.php}"

            export DB_DATABASE
            DB_DATABASE="$(cat /tmp/.test_db_name)"
            $TEST_COMMAND "$@"
            ;;

        docker-compose)
            # shellcheck disable=SC2086
            docker compose $COMPOSE_FILE_OPT exec -T \
                -e "RESOLVER_CLASS=$RESOLVER_CLASS" \
                -e "WORKTREE_BASENAME=$WORKTREE_BASENAME" \
                -e "TEST_COMMAND=$TEST_COMMAND" \
                -e "DB_DATABASE=${DB_DATABASE:-}" \
                -e "DB_HOST=${DB_HOST:-}" \
                -e "DB_PORT=${DB_PORT:-}" \
                -e "DB_USERNAME=${DB_USERNAME:-}" \
                -e "DB_PASSWORD=${DB_PASSWORD:-}" \
                "$COMPOSE_SERVICE" \
                bash -c '
                    php -r '"'"'
                        require "vendor/autoload.php";
                        $class = getenv("RESOLVER_CLASS") ?: "WorktreeIsolation\\TestDatabaseResolver";
                        $base  = getenv("DB_DATABASE") ?: "testing";
                        $wt    = getenv("WORKTREE_BASENAME") ?: "worktree";
                        $name  = $class::derive($base, $wt);
                        $class::ensureExists(
                            $name,
                            getenv("DB_HOST") ?: "127.0.0.1",
                            (int)(getenv("DB_PORT") ?: 3306),
                            getenv("DB_USERNAME") ?: "",
                            getenv("DB_PASSWORD") ?: "",
                        );
                        echo "Using test database: $name\n";
                        file_put_contents("/tmp/.test_db_name", $name);
                    '"'"' && \
                    export DB_DATABASE="$(cat /tmp/.test_db_name)" && \
                    $TEST_COMMAND "$@"
                ' -- "$@"
            ;;

        docker-image)
            build_docker_image_args
            DOCKER_ARGS+=(-e "WORKTREE_BASENAME=$WORKTREE_BASENAME")
            DOCKER_ARGS+=(-e "TEST_COMMAND=$TEST_COMMAND")

            exec "${DOCKER_ARGS[@]}" --entrypoint bash "$IMAGE" -c '
                php -r '"'"'
                    require "vendor/autoload.php";
                    $class = getenv("RESOLVER_CLASS") ?: "WorktreeIsolation\\TestDatabaseResolver";
                    $base  = getenv("DB_DATABASE") ?: "testing";
                    $wt    = getenv("WORKTREE_BASENAME") ?: "worktree";
                    $name  = $class::derive($base, $wt);
                    $class::ensureExists(
                        $name,
                        getenv("DB_HOST") ?: "127.0.0.1",
                        (int)(getenv("DB_PORT") ?: 3306),
                        getenv("DB_USERNAME") ?: "",
                        getenv("DB_PASSWORD") ?: "",
                    );
                    echo "Using test database: $name\n";
                    file_put_contents("/tmp/.test_db_name", $name);
                '"'"' && \
                export DB_DATABASE="$(cat /tmp/.test_db_name)" && \
                $TEST_COMMAND "$@"
            ' -- "$@"
            ;;
    esac
else
    # No per-worktree DB — just run tests directly
    case "$RUNTIME" in
        native)
            $TEST_COMMAND "$@"
            ;;
        docker-compose)
            # shellcheck disable=SC2086
            docker compose $COMPOSE_FILE_OPT exec -T \
                -e "TEST_COMMAND=$TEST_COMMAND" \
                "$COMPOSE_SERVICE" \
                bash -c '$TEST_COMMAND "$@"' -- "$@"
            ;;
        docker-image)
            build_docker_image_args
            DOCKER_ARGS+=(-e "TEST_COMMAND=$TEST_COMMAND")
            exec "${DOCKER_ARGS[@]}" --entrypoint bash "$IMAGE" -c '$TEST_COMMAND "$@"' -- "$@"
            ;;
    esac
fi
