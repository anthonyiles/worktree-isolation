#!/usr/bin/env bash
#
# Runs tests with per-worktree database isolation.
#
# Supports three runtime drivers (set WORKTREE_RUNTIME in .worktree-isolation.env):
#   native         — runs test command directly on the host
#   docker-compose — runs via `docker compose exec` in a running service container
#   docker-image   — runs via `docker run` with a standalone image (mounts project)
#
# The test command defaults to `php artisan test` but can be overridden via
# WORKTREE_TEST_COMMAND in .worktree-isolation.env (e.g. `php vendor/bin/phpunit`).
#
# Usage:
#   vendor/bin/worktree test                        # run all tests
#   vendor/bin/worktree test --filter=testName      # forward args to test runner
#   vendor/bin/worktree test tests/Feature/MyTest.php
#
# Invoked as `vendor/bin/worktree test` (stubs/bin/worktree dispatches
# straight into this file); not itself exposed as a Composer bin.
set -euo pipefail

# This file can still be invoked through a symlink (bats tests do this), so
# keep resolving one defensively even though vendor/bin/worktree calls it by
# a direct, non-symlinked path. readlink -f isn't portable (no -f on macOS's
# stock readlink), so resolve it manually.
resolve_script_dir() {
    local src="${BASH_SOURCE[0]}"
    while [[ -h "$src" ]]; do
        local dir
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(resolve_script_dir)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_worktree-lib.sh"

# ---------------------------------------------------------------------------
# 0. Load configuration
# ---------------------------------------------------------------------------
load_worktree_config
TEST_COMMAND="${WORKTREE_TEST_COMMAND:-php artisan test}"

# ---------------------------------------------------------------------------
# 1. Validate runtime
# ---------------------------------------------------------------------------
validate_runtime

# ---------------------------------------------------------------------------
# 2. Load testing env vars
# ---------------------------------------------------------------------------
if [[ -f "$PROJECT_ROOT/$TESTING_ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$PROJECT_ROOT/$TESTING_ENV_FILE"
    set +a
fi

# ---------------------------------------------------------------------------
# 3. Run tests
# ---------------------------------------------------------------------------
# Runs inside the target runtime. With ENSURE_DB_PHP set, it first derives and
# creates this worktree's test database and points DB_DATABASE at it.
RUN_TESTS='
    set -o pipefail
    if [[ -n "${ENSURE_DB_PHP:-}" ]]; then
        result="$(php -r "$ENSURE_DB_PHP" | tail -n 1)" || exit
        if [[ ! "$result" =~ ^[a-z0-9_-]+\ (created|existing)$ ]]; then
            echo "Error: could not derive the per-worktree test database." >&2
            exit 1
        fi
        export DB_DATABASE="${result%% *}"
        echo "Using test database: $DB_DATABASE"
    fi
    exec $TEST_COMMAND "$@"
'

TEST_ENV=(-e "TEST_COMMAND=$TEST_COMMAND")

if [[ "${!DB_PER_WORKTREE_KEY:-}" =~ ^(true|1)$ ]]; then
    TEST_ENV+=(
        -e "ENSURE_DB_PHP=$ENSURE_DB_PHP"
        -e "RESOLVER_CLASS=$RESOLVER_CLASS"
        -e "WORKTREE_BASENAME=$WORKTREE_BASENAME"
    )
    for var in DB_DATABASE DB_HOST DB_PORT DB_USERNAME DB_PASSWORD; do
        TEST_ENV+=(-e "$var=${!var:-}")
    done
fi

# A docker-image container starts fresh, so it also needs the testing env.
if [[ "$RUNTIME" == docker-image ]]; then
    append_testing_env_args
fi

run_in_runtime "${TEST_ENV[@]}" bash -c "$RUN_TESTS" -- "$@"
