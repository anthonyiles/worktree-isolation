#!/usr/bin/env bash
#
# Runs tests with per-worktree database isolation.
#
# Supports three runtime drivers (set WORKTREE_RUNTIME in .worktree-isolation.env):
#   native         — runs test command directly on the host
#   docker-compose — runs via `docker compose exec` in a running service container
#   docker-image   — runs via `docker run` with a standalone image (mounts project)
#
# The test command defaults to `php artisan test` but can be overridden via
# WORKTREE_TEST_COMMAND in .worktree-isolation.env (e.g. `php vendor/bin/phpunit`).
#
# Usage:
#   vendor/bin/worktree test                        # run all tests
#   vendor/bin/worktree test --filter=testName      # forward args to test runner
#   vendor/bin/worktree test tests/Feature/MyTest.php
#
# Invoked as `vendor/bin/worktree test` (stubs/bin/worktree dispatches
# straight into this file); not itself exposed as a Composer bin.
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_worktree-lib.sh"

# ---------------------------------------------------------------------------
# 0. Load configuration
# ---------------------------------------------------------------------------
load_worktree_config
require_worktree
TEST_COMMAND="${WORKTREE_TEST_COMMAND:-php artisan test}"

# ---------------------------------------------------------------------------
# 1. Validate runtime
# ---------------------------------------------------------------------------
validate_runtime

# ---------------------------------------------------------------------------
# 2. Load testing env vars
# ---------------------------------------------------------------------------
load_env_file "$PROJECT_ROOT/$TESTING_ENV_FILE"

# ---------------------------------------------------------------------------
# 3. Run tests
# ---------------------------------------------------------------------------
# Runs inside the target runtime, with sh: not every image has bash. With
# ENSURE_DB_PHP set, it first creates this worktree's test database
# (DB_DATABASE) if it's missing. PHP's output is only shown on failure, since
# the CLI prints errors to stdout.
# shellcheck disable=SC2016 # expanded by the inner shell
RUN_TESTS='
    if [ -n "${ENSURE_DB_PHP:-}" ]; then
        if ! output="$(php -r "$ENSURE_DB_PHP" 2>&1)"; then
            printf "%s\n" "$output" >&2
            echo "Error: could not create the test database $DB_DATABASE." >&2
            exit 1
        fi
        echo "Using test database: $DB_DATABASE"
    fi
    # eval, so quotes in WORKTREE_TEST_COMMAND group arguments as in a shell.
    eval "exec $TEST_COMMAND \"\$@\""
'

TEST_ENV=(-e "TEST_COMMAND=$TEST_COMMAND")
cache_phpunit "$PROJECT_ROOT"

# The test database is passed in the environment, which beats .env,
# .env.testing and phpunit.xml's <env>, so no file needs to name it.
TEST_CONNECTION="$(tests_connection)"
if [[ "$TEST_CONNECTION" =~ $SERVER_CONNECTIONS ]]; then
    if ! DB_DATABASE="$(derive_test_database_name "$(test_database_base)" "$WORKTREE_KEY")"; then
        echo "Error: could not derive the per-worktree test database from '$(test_database_base)'." >&2
        exit 1
    fi
    warn_if_phpunit_forces_database
    record_database test "$DB_DATABASE"
    db_env_args test "$PROJECT_ROOT"
    TEST_ENV+=(
        -e "ENSURE_DB_PHP=$ENSURE_DB_PHP"
        -e "MAIN_DB_DATABASE=$(main_test_database)"
        -e "DB_DATABASE=$DB_DATABASE"
        ${DB_ENV[@]+"${DB_ENV[@]}"}
    )
elif [[ "$TEST_CONNECTION" == sqlite ]]; then
    if ! sqlite="$(sqlite_worktree_path "$(test_db_setting "$PROJECT_ROOT" DB_DATABASE || true)")"; then
        echo "Warning: the tests' SQLite DB_DATABASE is outside $WORKDIR, so this worktree shares that file." >&2
    elif [[ -n "$sqlite" ]]; then
        ensure_sqlite_file "${sqlite#*$'\t'}" > /dev/null
        if [[ -n "${sqlite%%$'\t'*}" ]]; then
            DB_DATABASE="${sqlite%%$'\t'*}"
            warn_if_phpunit_forces_database
            TEST_ENV+=(-e "DB_DATABASE=$DB_DATABASE")
        fi
    fi
fi

# A container doesn't inherit this shell's environment, so pass it every
# testing env value, by name (see run_in_runtime). Natively the test command
# inherits them from load_env_file.
if [[ "$RUNTIME" != native ]]; then
    while IFS= read -r key; do
        TEST_ENV+=(-e "$key=${!key-}")
    done < <(env_file_keys "$PROJECT_ROOT/$TESTING_ENV_FILE")
fi

run_in_runtime "${TEST_ENV[@]}" sh -c "$RUN_TESTS" sh "$@"
