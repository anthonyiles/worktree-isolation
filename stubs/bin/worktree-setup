#!/usr/bin/env bash
#
# Bootstraps a git worktree with dependencies and environment files.
#
# Supports three runtime drivers (set WORKTREE_RUNTIME in .worktree-isolation.env):
#   native         — runs composer/npm directly on the host (Herd, Valet, etc.)
#   docker-compose — runs via `docker compose exec` in a running service container
#   docker-image   — runs via `docker run` with a standalone image (Sail, etc.)
#
# Usage (after creating a worktree):
#   git worktree add ../worktrees/my-project/my-branch my-branch
#   cd ../worktrees/my-project/my-branch
#   vendor/bin/worktree setup
#
# Invoked as `vendor/bin/worktree setup` (stubs/bin/worktree dispatches
# straight into this file) or directly by the post-checkout git hook; not
# itself exposed as a Composer bin.
set -euo pipefail

# This file can still be invoked through a symlink (bats' "resolves
# _worktree-lib.sh when invoked through a symlink" test does this), so keep
# resolving one defensively even though vendor/bin/worktree calls it by a
# direct, non-symlinked path. readlink -f isn't portable (no -f on macOS's
# stock readlink), so resolve it manually.
resolve_script_dir() {
    local src="${BASH_SOURCE[0]}"
    while [[ -h "$src" ]]; do
        local dir
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(resolve_script_dir)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_worktree-lib.sh"

# ---------------------------------------------------------------------------
# 0. Load configuration
# ---------------------------------------------------------------------------
load_worktree_config
TESTING_ENV_EXAMPLE="${WORKTREE_TESTING_ENV_EXAMPLE:-.env.testing.example}"

# ---------------------------------------------------------------------------
# 1. Validate runtime and prerequisites
# ---------------------------------------------------------------------------
validate_runtime

# ---------------------------------------------------------------------------
# 2. Resolve the main repo path from the worktree's .git file
# ---------------------------------------------------------------------------
MAIN_REPO=""

if [[ -f "$PROJECT_ROOT/.git" ]]; then
    GITDIR="$(sed 's/^gitdir: //' "$PROJECT_ROOT/.git")"

    if [[ -d "$GITDIR" ]]; then
        MAIN_REPO="$(cd "$GITDIR/../../.." && pwd)"

        if [[ ! -d "$MAIN_REPO/.git" ]]; then
            echo "Warning: Could not resolve main repo from '$GITDIR'. Skipping .env copy." >&2
            MAIN_REPO=""
        fi
    fi
elif [[ -d "$PROJECT_ROOT/.git" ]]; then
    echo "This directory is the main repo, not a worktree. Nothing to set up." >&2
    exit 0
fi

# ---------------------------------------------------------------------------
# 3. Copy .env files from the main repo if they don't exist here
# ---------------------------------------------------------------------------
if [[ -n "$MAIN_REPO" ]]; then
    # .env
    if [[ ! -f "$PROJECT_ROOT/.env" && -f "$MAIN_REPO/.env" ]]; then
        cp "$MAIN_REPO/.env" "$PROJECT_ROOT/.env"
        echo "Copied .env from main repo."
    elif [[ -f "$PROJECT_ROOT/.env" ]]; then
        echo ".env already exists, skipping."
    else
        echo "Warning: .env not found in main repo either." >&2
    fi

    # Testing env file — fall back to example if needed
    if [[ ! -f "$PROJECT_ROOT/$TESTING_ENV_FILE" ]]; then
        if [[ -f "$MAIN_REPO/$TESTING_ENV_FILE" ]]; then
            cp "$MAIN_REPO/$TESTING_ENV_FILE" "$PROJECT_ROOT/$TESTING_ENV_FILE"
            echo "Copied $TESTING_ENV_FILE from main repo."
        elif [[ -f "$MAIN_REPO/$TESTING_ENV_EXAMPLE" ]]; then
            cp "$MAIN_REPO/$TESTING_ENV_EXAMPLE" "$PROJECT_ROOT/$TESTING_ENV_FILE"
            echo "Copied $TESTING_ENV_FILE from $TESTING_ENV_EXAMPLE."
        else
            echo "Warning: $TESTING_ENV_FILE not found in main repo." >&2
        fi
    else
        echo "$TESTING_ENV_FILE already exists, skipping."
    fi

    # Worktrees must use per-worktree test databases to avoid conflicts
    if [[ -f "$PROJECT_ROOT/$TESTING_ENV_FILE" ]]; then
        set_env_file_value "$PROJECT_ROOT/$TESTING_ENV_FILE" "$DB_PER_WORKTREE_KEY" true
        echo "Enabled ${DB_PER_WORKTREE_KEY}=true for this worktree."
    fi
else
    echo "Warning: Could not find main repo. Copy .env and $TESTING_ENV_FILE manually." >&2
fi

# ---------------------------------------------------------------------------
# 4. Bring up this worktree's own Compose stack
# ---------------------------------------------------------------------------
# Bind mounts are resolved once, at `up` time, to whatever host directory the
# stack is started from — a running container can't be repointed at a
# different worktree via `exec`. So each worktree needs its own stack,
# scoped by COMPOSE_PROJECT_NAME, rather than assuming one is already up.
if [[ "$RUNTIME" == "docker-compose" ]]; then
    echo ""
    echo "Starting Docker Compose stack ($COMPOSE_PROJECT_NAME)..."
    "${COMPOSE_ARGS[@]}" up -d
fi

# ---------------------------------------------------------------------------
# 5. Install Composer dependencies
# ---------------------------------------------------------------------------
echo ""
echo "Installing Composer dependencies..."
run_in_runtime composer install --no-interaction --no-progress

# ---------------------------------------------------------------------------
# 6. Per-worktree databases
# ---------------------------------------------------------------------------
ENSURE_DB_PHP='
    require "vendor/autoload.php";
    $class = getenv("RESOLVER_CLASS");
    $name = $class::derive(getenv("DB_DATABASE"), getenv("WORKTREE_BASENAME"));
    $created = $class::ensureExists(
        $name,
        getenv("DB_HOST") ?: "127.0.0.1",
        (int) (getenv("DB_PORT") ?: 3306),
        getenv("DB_USERNAME") ?: "",
        getenv("DB_PASSWORD") ?: "",
    );
    echo $name, $created === true ? " created" : " existing";
'

# Prints "<name> created|existing".
ensure_worktree_database() {
    local env_file="$1" resolver="$2" base_db="$3"
    run_in_runtime \
        -e "RESOLVER_CLASS=$resolver" \
        -e "WORKTREE_BASENAME=$WORKTREE_BASENAME" \
        -e "DB_DATABASE=$base_db" \
        -e "DB_HOST=$(env_file_value "$env_file" DB_HOST)" \
        -e "DB_PORT=$(env_file_value "$env_file" DB_PORT)" \
        -e "DB_USERNAME=$(env_file_value "$env_file" DB_USERNAME)" \
        -e "DB_PASSWORD=$(env_file_value "$env_file" DB_PASSWORD)" \
        php -r "$ENSURE_DB_PHP"
}

# Writing DB_DATABASE into $TESTING_ENV_FILE means sail test, artisan test,
# and phpunit all read the isolated database too, not just vendor/bin/worktree test.
TESTING_ENV_PATH="$PROJECT_ROOT/$TESTING_ENV_FILE"
if [[ -f "$TESTING_ENV_PATH" ]]; then
    echo ""
    echo "Deriving per-worktree test database..."

    base_db="$(env_file_value "$TESTING_ENV_PATH" DB_DATABASE)"
    # A DB failure here (MySQL down, bad creds, missing driver) must not abort
    # setup; vendor/bin/worktree test retries this derivation later.
    if result="$(ensure_worktree_database "$TESTING_ENV_PATH" "$RESOLVER_CLASS" "${base_db:-testing}")" && [[ -n "$result" ]]; then
        set_env_file_value "$TESTING_ENV_PATH" DB_DATABASE "${result%% *}"
        echo "Set DB_DATABASE=${result%% *} in $TESTING_ENV_FILE"
    else
        echo "Warning: Could not derive the per-worktree test database — check DB_* settings in $TESTING_ENV_FILE." >&2
        echo "  vendor/bin/worktree test will still derive and create it on first run." >&2
    fi
fi

DEV_DB_PER_WORKTREE="${WORKTREE_DEV_DB_PER_WORKTREE:-true}"
DEV_DB_MIGRATE_COMMAND="${WORKTREE_DEV_DB_MIGRATE_COMMAND-php artisan migrate --no-interaction}"
DEV_DB_SEED_COMMAND="${WORKTREE_DEV_DB_SEED_COMMAND-php artisan db:seed --no-interaction}"
ENV_PATH="$PROJECT_ROOT/.env"

if [[ "$DEV_DB_PER_WORKTREE" =~ ^(true|1)$ && -f "$ENV_PATH" ]]; then
    echo ""
    echo "Deriving per-worktree development database..."

    connection="$(env_file_value "$ENV_PATH" DB_CONNECTION)"
    base_db="$(env_file_value "$ENV_PATH" DB_DATABASE)"
    if [[ ! "$connection" =~ ^(mysql|mariadb)$ ]]; then
        echo "Skipping: only MySQL/MariaDB are supported (DB_CONNECTION=${connection:-unset})."
    elif [[ -z "$base_db" ]]; then
        echo "Skipping: DB_DATABASE is not set in .env."
    elif result="$(ensure_worktree_database "$ENV_PATH" 'WorktreeIsolation\DevDatabaseResolver' "$base_db")" && [[ -n "$result" ]]; then
        set_env_file_value "$ENV_PATH" DB_DATABASE "${result%% *}"
        echo "Set DB_DATABASE=${result%% *} in .env"

        if [[ -n "$DEV_DB_MIGRATE_COMMAND" ]]; then
            echo "Running: $DEV_DB_MIGRATE_COMMAND"
            # shellcheck disable=SC2086
            run_in_runtime $DEV_DB_MIGRATE_COMMAND || echo "Warning: migrate command failed." >&2
        fi
        # Seeding isn't idempotent, so only seed a database this run created.
        if [[ -n "$DEV_DB_SEED_COMMAND" && "$result" == *" created" ]]; then
            echo "Running: $DEV_DB_SEED_COMMAND"
            # shellcheck disable=SC2086
            run_in_runtime $DEV_DB_SEED_COMMAND || echo "Warning: seed command failed." >&2
        fi
    else
        echo "Warning: Could not create the per-worktree development database — check DB_* settings in .env." >&2
        echo "  .env still points at the shared database '$base_db'." >&2
    fi
fi

# ---------------------------------------------------------------------------
# 7. Install npm dependencies
# ---------------------------------------------------------------------------
echo ""
echo "Installing npm dependencies..."
run_in_runtime npm install --no-progress

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
echo ""
echo "Worktree setup complete. You can now run tests with: vendor/bin/worktree test"
