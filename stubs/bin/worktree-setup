#!/usr/bin/env bash
#
# Bootstraps a git worktree with dependencies and environment files.
#
# Supports three runtime drivers (set WORKTREE_RUNTIME in .worktree-isolation.env):
#   native         — runs composer/npm directly on the host (Herd, Valet, etc.)
#   docker-compose — runs via `docker compose exec` in a running service container
#   docker-image   — runs via `docker run` with a standalone image (Sail, etc.)
#
# Usage (after creating a worktree):
#   git worktree add ../worktrees/my-project/my-branch my-branch
#   cd ../worktrees/my-project/my-branch
#   vendor/bin/worktree-setup
#
set -euo pipefail

# git sets cwd to the worktree root before invoking post-checkout, so this
# resolves correctly even though the script itself lives in vendor/.
PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# ---------------------------------------------------------------------------
# 0. Load configuration
# ---------------------------------------------------------------------------
CONF_FILE="$PROJECT_ROOT/.worktree-isolation.env"
if [[ -f "$CONF_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$CONF_FILE"
    set +a
fi

RUNTIME="${WORKTREE_RUNTIME:-native}"
TESTING_ENV_FILE="${WORKTREE_TESTING_ENV_FILE:-.env.testing}"
TESTING_ENV_EXAMPLE="${WORKTREE_TESTING_ENV_EXAMPLE:-.env.testing.example}"
DB_PER_WORKTREE_KEY="${WORKTREE_DB_PER_WORKTREE_KEY:-TEST_DB_PER_WORKTREE}"
RESOLVER_CLASS="${WORKTREE_RESOLVER_CLASS:-WorktreeIsolation\\TestDatabaseResolver}"

# docker-image driver settings
IMAGE="${WORKTREE_DOCKER_IMAGE:-}"
NETWORK="${WORKTREE_DOCKER_NETWORK:-}"
WORKDIR="${WORKTREE_DOCKER_WORKDIR:-/var/www/html}"

# docker-compose driver settings
COMPOSE_SERVICE="${WORKTREE_COMPOSE_SERVICE:-app}"
COMPOSE_FILE_OPT=""
if [[ -n "${WORKTREE_COMPOSE_FILE:-}" ]]; then
    COMPOSE_FILE_OPT="-f $WORKTREE_COMPOSE_FILE"
fi

# ---------------------------------------------------------------------------
# 1. Validate runtime and prerequisites
# ---------------------------------------------------------------------------
case "$RUNTIME" in
    native)
        ;;
    docker-compose)
        if ! docker compose version > /dev/null 2>&1; then
            echo "Error: 'docker compose' not found. Install Docker with the Compose plugin." >&2
            exit 1
        fi
        ;;
    docker-image)
        if [[ -z "$IMAGE" ]]; then
            echo "Error: WORKTREE_DOCKER_IMAGE must be set for the docker-image runtime." >&2
            exit 1
        fi
        if ! docker image inspect "$IMAGE" > /dev/null 2>&1; then
            echo "Error: Docker image '$IMAGE' not found." >&2
            echo "Build it first (e.g. 'docker compose build' or 'vendor/bin/sail build')." >&2
            exit 1
        fi
        ;;
    *)
        echo "Error: Unknown WORKTREE_RUNTIME '$RUNTIME'. Use: native, docker-compose, or docker-image." >&2
        exit 1
        ;;
esac

# ---------------------------------------------------------------------------
# 2. Resolve the main repo path from the worktree's .git file
# ---------------------------------------------------------------------------
MAIN_REPO=""

if [[ -f "$PROJECT_ROOT/.git" ]]; then
    GITDIR="$(sed 's/^gitdir: //' "$PROJECT_ROOT/.git")"

    if [[ -d "$GITDIR" ]]; then
        MAIN_REPO="$(cd "$GITDIR/../../.." && pwd)"

        if [[ ! -d "$MAIN_REPO/.git" ]]; then
            echo "Warning: Could not resolve main repo from '$GITDIR'. Skipping .env copy." >&2
            MAIN_REPO=""
        fi
    fi
elif [[ -d "$PROJECT_ROOT/.git" ]]; then
    echo "This directory is the main repo, not a worktree. Nothing to set up." >&2
    exit 0
fi

# ---------------------------------------------------------------------------
# 3. Copy .env files from the main repo if they don't exist here
# ---------------------------------------------------------------------------
if [[ -n "$MAIN_REPO" ]]; then
    # .env
    if [[ ! -f "$PROJECT_ROOT/.env" && -f "$MAIN_REPO/.env" ]]; then
        cp "$MAIN_REPO/.env" "$PROJECT_ROOT/.env"
        echo "Copied .env from main repo."
    elif [[ -f "$PROJECT_ROOT/.env" ]]; then
        echo ".env already exists, skipping."
    else
        echo "Warning: .env not found in main repo either." >&2
    fi

    # Testing env file — fall back to example if needed
    if [[ ! -f "$PROJECT_ROOT/$TESTING_ENV_FILE" ]]; then
        if [[ -f "$MAIN_REPO/$TESTING_ENV_FILE" ]]; then
            cp "$MAIN_REPO/$TESTING_ENV_FILE" "$PROJECT_ROOT/$TESTING_ENV_FILE"
            echo "Copied $TESTING_ENV_FILE from main repo."
        elif [[ -f "$MAIN_REPO/$TESTING_ENV_EXAMPLE" ]]; then
            cp "$MAIN_REPO/$TESTING_ENV_EXAMPLE" "$PROJECT_ROOT/$TESTING_ENV_FILE"
            echo "Copied $TESTING_ENV_FILE from $TESTING_ENV_EXAMPLE."
        else
            echo "Warning: $TESTING_ENV_FILE not found in main repo." >&2
        fi
    else
        echo "$TESTING_ENV_FILE already exists, skipping."
    fi

    # Worktrees must use per-worktree test databases to avoid conflicts
    if [[ -f "$PROJECT_ROOT/$TESTING_ENV_FILE" ]]; then
        if grep -q "^${DB_PER_WORKTREE_KEY}=" "$PROJECT_ROOT/$TESTING_ENV_FILE"; then
            sed -i.bak "s/^${DB_PER_WORKTREE_KEY}=.*/${DB_PER_WORKTREE_KEY}=true/" "$PROJECT_ROOT/$TESTING_ENV_FILE"
            rm -f "$PROJECT_ROOT/$TESTING_ENV_FILE.bak"
        else
            echo "${DB_PER_WORKTREE_KEY}=true" >> "$PROJECT_ROOT/$TESTING_ENV_FILE"
        fi
        echo "Enabled ${DB_PER_WORKTREE_KEY}=true for this worktree."
    fi
else
    echo "Warning: Could not find main repo. Copy .env and $TESTING_ENV_FILE manually." >&2
fi

# ---------------------------------------------------------------------------
# 4. Install Composer dependencies
# ---------------------------------------------------------------------------
echo ""
echo "Installing Composer dependencies..."

case "$RUNTIME" in
    native)
        composer install --no-interaction --no-progress
        ;;
    docker-compose)
        # shellcheck disable=SC2086
        docker compose $COMPOSE_FILE_OPT exec -T "$COMPOSE_SERVICE" \
            composer install --no-interaction --no-progress
        ;;
    docker-image)
        docker run --rm \
            -v "$PROJECT_ROOT:$WORKDIR" \
            -w "$WORKDIR" \
            --entrypoint composer \
            "$IMAGE" \
            install --no-interaction --no-progress
        ;;
esac

# ---------------------------------------------------------------------------
# 5. Derive and create the per-worktree test database
# ---------------------------------------------------------------------------
# Writing DB_DATABASE into $TESTING_ENV_FILE means sail test, artisan test,
# and phpunit all read the isolated database too, not just vendor/bin/test.
# vendor/bin/test re-derives it independently on every run as well.
if [[ -f "$PROJECT_ROOT/$TESTING_ENV_FILE" ]]; then
    echo ""
    echo "Deriving per-worktree test database..."

    # set -a exports DB_* (and friends) so the PHP snippet below can read
    # them via getenv().
    set -a
    # shellcheck disable=SC1090
    source "$PROJECT_ROOT/$TESTING_ENV_FILE"
    set +a

    WORKTREE_BASENAME="$(basename "$PROJECT_ROOT")"

    DERIVE_DB_PHP='
        require "__AUTOLOAD__";
        $class = getenv("RESOLVER_CLASS") ?: "WorktreeIsolation\\TestDatabaseResolver";
        $base  = getenv("DB_DATABASE") ?: "testing";
        $wt    = getenv("WORKTREE_BASENAME") ?: "worktree";
        $name  = $class::derive($base, $wt);
        $class::ensureExists(
            $name,
            getenv("DB_HOST") ?: "127.0.0.1",
            (int)(getenv("DB_PORT") ?: 3306),
            getenv("DB_USERNAME") ?: "",
            getenv("DB_PASSWORD") ?: "",
        );
        echo $name;
    '

    # set +e: a DB failure here (MySQL down, bad creds, missing driver) must
    # not abort setup — npm install still needs to run, and vendor/bin/test
    # retries this derivation later.
    set +e
    DERIVED_DB=""
    case "$RUNTIME" in
        native)
            DERIVED_DB="$(
                RESOLVER_CLASS="$RESOLVER_CLASS" \
                WORKTREE_BASENAME="$WORKTREE_BASENAME" \
                    php -r "${DERIVE_DB_PHP//__AUTOLOAD__/$PROJECT_ROOT/vendor/autoload.php}"
            )"
            ;;
        docker-compose)
            # shellcheck disable=SC2086
            DERIVED_DB="$(
                docker compose $COMPOSE_FILE_OPT exec -T \
                    -e "RESOLVER_CLASS=$RESOLVER_CLASS" \
                    -e "WORKTREE_BASENAME=$WORKTREE_BASENAME" \
                    -e "DB_DATABASE=${DB_DATABASE:-}" \
                    -e "DB_HOST=${DB_HOST:-}" \
                    -e "DB_PORT=${DB_PORT:-}" \
                    -e "DB_USERNAME=${DB_USERNAME:-}" \
                    -e "DB_PASSWORD=${DB_PASSWORD:-}" \
                    "$COMPOSE_SERVICE" \
                    php -r "${DERIVE_DB_PHP//__AUTOLOAD__/vendor/autoload.php}"
            )"
            ;;
        docker-image)
            DOCKER_NETWORK_OPT=()
            if [[ -n "$NETWORK" ]]; then
                DOCKER_NETWORK_OPT=(--network "$NETWORK")
            fi
            DERIVED_DB="$(
                docker run --rm \
                    -v "$PROJECT_ROOT:$WORKDIR" \
                    -w "$WORKDIR" \
                    "${DOCKER_NETWORK_OPT[@]}" \
                    -e "RESOLVER_CLASS=$RESOLVER_CLASS" \
                    -e "WORKTREE_BASENAME=$WORKTREE_BASENAME" \
                    -e "DB_DATABASE=${DB_DATABASE:-}" \
                    -e "DB_HOST=${DB_HOST:-}" \
                    -e "DB_PORT=${DB_PORT:-}" \
                    -e "DB_USERNAME=${DB_USERNAME:-}" \
                    -e "DB_PASSWORD=${DB_PASSWORD:-}" \
                    --entrypoint php \
                    "$IMAGE" \
                    -r "${DERIVE_DB_PHP//__AUTOLOAD__/vendor/autoload.php}"
            )"
            ;;
    esac
    set -e

    if [[ -n "$DERIVED_DB" ]]; then
        if grep -q "^DB_DATABASE=" "$PROJECT_ROOT/$TESTING_ENV_FILE"; then
            sed -i.bak "s/^DB_DATABASE=.*/DB_DATABASE=${DERIVED_DB}/" "$PROJECT_ROOT/$TESTING_ENV_FILE"
            rm -f "$PROJECT_ROOT/$TESTING_ENV_FILE.bak"
        else
            echo "DB_DATABASE=${DERIVED_DB}" >> "$PROJECT_ROOT/$TESTING_ENV_FILE"
        fi
        echo "Set DB_DATABASE=${DERIVED_DB} in $TESTING_ENV_FILE"
    else
        echo "Warning: Could not derive the per-worktree database name — check DB_* settings in $TESTING_ENV_FILE." >&2
        echo "  vendor/bin/test will still derive and create it on first run." >&2
    fi
fi

# ---------------------------------------------------------------------------
# 6. Install npm dependencies
# ---------------------------------------------------------------------------
echo ""
echo "Installing npm dependencies..."

case "$RUNTIME" in
    native)
        npm install --no-progress
        ;;
    docker-compose)
        # shellcheck disable=SC2086
        docker compose $COMPOSE_FILE_OPT exec -T "$COMPOSE_SERVICE" \
            npm install --no-progress
        ;;
    docker-image)
        docker run --rm \
            -v "$PROJECT_ROOT:$WORKDIR" \
            -w "$WORKDIR" \
            --entrypoint npm \
            "$IMAGE" \
            install --no-progress
        ;;
esac

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
echo ""
echo "Worktree setup complete. You can now run tests with: vendor/bin/test"
