#!/usr/bin/env bash
#
# Bootstraps a git worktree with dependencies and environment files.
#
# Supports three runtime drivers (set WORKTREE_RUNTIME in .worktree-isolation.env):
#   native         — runs composer/npm directly on the host (Herd, Valet, etc.)
#   docker-compose — runs via `docker compose exec` in a running service container
#   docker-image   — runs via `docker run` with a standalone image (Sail, etc.)
#
# Usage (after creating a worktree):
#   git worktree add ../worktrees/my-project/my-branch my-branch
#   cd ../worktrees/my-project/my-branch
#   vendor/bin/worktree setup
#
# Invoked as `vendor/bin/worktree setup` (stubs/bin/worktree dispatches
# straight into this file) or directly by the post-checkout git hook; not
# itself exposed as a Composer bin.
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_worktree-lib.sh"

# ---------------------------------------------------------------------------
# 0. Load configuration
# ---------------------------------------------------------------------------
load_worktree_config --skip-if-missing
DEV_DB_MIGRATE_COMMAND="${WORKTREE_DEV_DB_MIGRATE_COMMAND-php artisan migrate --no-interaction}"
DEV_DB_SEED_COMMAND="${WORKTREE_DEV_DB_SEED_COMMAND-php artisan db:seed --no-interaction}"
DB_WAIT_SECONDS="${WORKTREE_DB_WAIT_SECONDS:-30}"
POST_SETUP_COMMAND="${WORKTREE_POST_SETUP_COMMAND:-}"

# ---------------------------------------------------------------------------
# 1. Resolve the main checkout
# ---------------------------------------------------------------------------
if in_main_checkout; then
    echo "This directory is the main repo, not a worktree. Nothing to set up." >&2
    exit 0
fi
MAIN_REPO="$(main_checkout_dir)"

# ---------------------------------------------------------------------------
# 2. Validate runtime and prerequisites
# ---------------------------------------------------------------------------
validate_runtime

# ---------------------------------------------------------------------------
# 3. Copy .env files from the main repo if they don't exist here
# ---------------------------------------------------------------------------
if [[ ! -f "$PROJECT_ROOT/.env" && -f "$MAIN_REPO/.env" ]]; then
    cp "$MAIN_REPO/.env" "$PROJECT_ROOT/.env"
    echo "Copied .env from main repo."
elif [[ -f "$PROJECT_ROOT/.env" ]]; then
    echo ".env already exists, skipping."
else
    echo "Warning: .env not found in main repo either." >&2
fi

# Testing env file, if the project has one — fall back to example if needed
if [[ ! -f "$PROJECT_ROOT/$TESTING_ENV_FILE" ]]; then
    if [[ -f "$MAIN_REPO/$TESTING_ENV_FILE" ]]; then
        cp "$MAIN_REPO/$TESTING_ENV_FILE" "$PROJECT_ROOT/$TESTING_ENV_FILE"
        echo "Copied $TESTING_ENV_FILE from main repo."
    elif [[ -f "$MAIN_REPO/$TESTING_ENV_EXAMPLE" ]]; then
        cp "$MAIN_REPO/$TESTING_ENV_EXAMPLE" "$PROJECT_ROOT/$TESTING_ENV_FILE"
        echo "Copied $TESTING_ENV_FILE from $TESTING_ENV_EXAMPLE."
    fi
else
    echo "$TESTING_ENV_FILE already exists, skipping."
fi

# Other untracked files the project needs, e.g. auth.json.
read -ra COPY_FILES <<< "${WORKTREE_COPY_FILES:-}"
for file in ${COPY_FILES[@]+"${COPY_FILES[@]}"}; do
    if [[ -e "$PROJECT_ROOT/$file" ]]; then
        echo "$file already exists, skipping."
    elif [[ -e "$MAIN_REPO/$file" ]]; then
        mkdir -p "$(dirname "$PROJECT_ROOT/$file")"
        cp -R "$MAIN_REPO/$file" "$PROJECT_ROOT/$file"
        echo "Copied $file from main repo."
    else
        echo "Warning: $file not found in main repo." >&2
    fi
done
cache_phpunit "$PROJECT_ROOT"

# Per-worktree test databases only apply when the tests use MySQL/MariaDB;
# anything else (e.g. SQLite) keeps its testing env untouched.
TESTING_ENV_PATH="$PROJECT_ROOT/$TESTING_ENV_FILE"
ENV_PATH="$PROJECT_ROOT/.env"
TEST_DB_PER_WORKTREE=false
tests_use_mysql && TEST_DB_PER_WORKTREE=true

# Per-worktree development databases are off unless configured; install
# writes WORKTREE_DEV_DB_PER_WORKTREE=true.
DEV_DB_PER_WORKTREE=false
if [[ "${WORKTREE_DEV_DB_PER_WORKTREE:-}" == true && -f "$ENV_PATH" ]]; then
    connection="$(env_file_value "$ENV_PATH" DB_CONNECTION)"
    if [[ "$connection" =~ ^(mysql|mariadb)$ ]]; then
        DEV_DB_PER_WORKTREE=true
    else
        echo "Skipping the per-worktree development database: only MySQL/MariaDB are supported (DB_CONNECTION=${connection:-unset})."
    fi
fi

# ---------------------------------------------------------------------------
# 3b. Point the env files away from the main checkout's databases
# ---------------------------------------------------------------------------
# Done before anything runs (the Compose stack, composer scripts, an
# entrypoint that migrates) so nothing can reach the main databases. Names
# are derived from the main checkout's, so a blank or stale value in the
# worktree still gets the right one; when no safe name can be derived,
# DB_DATABASE is left blank instead.
MAIN_TEST_DB="$(main_test_database)"
MAIN_DEV_DB="$(main_dev_database)"
TEST_DB=""
DEV_DB=""

if [[ "$DEV_DB_PER_WORKTREE" == true ]]; then
    DEV_DB="$(derive_dev_database_name "${MAIN_DEV_DB:-$(env_file_value "$ENV_PATH" DB_DATABASE)}" "$WORKTREE_KEY")" || DEV_DB=""
    [[ "$DEV_DB" != "$MAIN_DEV_DB" ]] || DEV_DB=""
    set_env_file_value "$ENV_PATH" DB_DATABASE "$DEV_DB"
    [[ -z "$DEV_DB" ]] || record_database development "$DEV_DB"
fi

# vendor/bin/worktree test passes the test database in the environment. A
# testing env file gets it too, so running the tests directly (php artisan
# test, phpunit) doesn't use the main checkout's.
if [[ "$TEST_DB_PER_WORKTREE" == true ]]; then
    TEST_DB="$(derive_test_database_name "$(test_database_base)" "$WORKTREE_KEY")" || TEST_DB=""
    if [[ "$TEST_DB" == "$MAIN_TEST_DB" || "$TEST_DB" == "$MAIN_DEV_DB" || ( -n "$DEV_DB" && "$TEST_DB" == "$DEV_DB" ) ]]; then
        TEST_DB=""
    fi
    [[ -z "$TEST_DB" ]] || record_database test "$TEST_DB"
    [[ ! -f "$TESTING_ENV_PATH" ]] || set_env_file_value "$TESTING_ENV_PATH" DB_DATABASE "$TEST_DB"
    warn_if_phpunit_forces_database
fi

# ---------------------------------------------------------------------------
# 4. Bring up this worktree's own Compose stack
# ---------------------------------------------------------------------------
# Bind mounts are resolved once, at `up` time, to whatever host directory the
# stack is started from — a running container can't be repointed at a
# different worktree via `exec`. So each worktree needs its own stack,
# scoped by COMPOSE_PROJECT_NAME, rather than assuming one is already up.
if [[ "$RUNTIME" == "docker-compose" ]]; then
    echo ""
    echo "Starting Docker Compose stack ($COMPOSE_PROJECT_NAME)..."
    write_compose_override
    [[ ! -f "$ENV_PATH" ]] || point_compose_at_worktree_stack "$ENV_PATH"
    "${COMPOSE_ARGS[@]}" up -d
fi

# ---------------------------------------------------------------------------
# 5. Install Composer dependencies
# ---------------------------------------------------------------------------
echo ""
echo "Installing Composer dependencies..."
run_in_runtime composer install --no-interaction --no-progress

# Sail 1.55+ reaches docker through SAIL_DOCKER_BINARY, read from .env, so an
# unchanged `sail ...` (e.g. in a project's git hook) runs in this worktree.
SAIL_DOCKER=""
if [[ "$RUNTIME" == docker-image && -f "$ENV_PATH" ]] && sail_docker_binary_usable "$PROJECT_ROOT" "$SCRIPT_DIR/sail-docker"; then
    SAIL_DOCKER="$SCRIPT_DIR/sail-docker"
    set_env_file_value "$ENV_PATH" SAIL_DOCKER_BINARY "$SAIL_DOCKER"
fi

# ---------------------------------------------------------------------------
# 6. Per-worktree databases
# ---------------------------------------------------------------------------
# Usage: ensure_worktree_database test|development NAME MAIN_DB
# Prints "<name> created|existing".
ensure_worktree_database() {
    local kind="$1" name="$2" main_db="$3" output
    db_env_args "$kind" "$PROJECT_ROOT"
    output="$(run_in_runtime ${DB_ENV[@]+"${DB_ENV[@]}"} \
        -e "MAIN_DB_DATABASE=$main_db" \
        -e "DB_DATABASE=$name" \
        php -r "$ENSURE_DB_PHP")" || return
    parse_ensure_db_output "$output"
}

# A freshly started Compose database can take a while to accept connections.
ensure_worktree_database_with_wait() {
    local deadline=$((SECONDS + DB_WAIT_SECONDS))
    until ensure_worktree_database "$@" 2> /dev/null; do
        if (( SECONDS >= deadline )); then
            ensure_worktree_database "$@"
            return
        fi
        sleep 2
    done
}

ENSURE_DB=ensure_worktree_database
if [[ "$RUNTIME" == "docker-compose" && "$DB_WAIT_SECONDS" -gt 0 ]]; then
    ENSURE_DB=ensure_worktree_database_with_wait
fi

if [[ "$TEST_DB_PER_WORKTREE" == true ]]; then
    echo ""
    echo "Creating per-worktree test database..."

    if [[ -z "$TEST_DB" ]]; then
        echo "Warning: Could not derive a test database name from '$(test_database_base)'." >&2
    # A DB failure here (MySQL down, bad creds, missing driver) must not abort
    # setup; vendor/bin/worktree test creates the database on first run.
    elif ! $ENSURE_DB test "$TEST_DB" "$MAIN_TEST_DB" > /dev/null; then
        echo "Warning: Could not create the test database '$TEST_DB' — check the DB_* settings the tests use." >&2
        echo "  vendor/bin/worktree test will create it on first run." >&2
    else
        echo "Using test database $TEST_DB"
    fi
fi

if [[ "$DEV_DB_PER_WORKTREE" == true ]]; then
    echo ""
    echo "Creating per-worktree development database..."

    if [[ -z "$DEV_DB" ]]; then
        echo "Warning: Could not derive a development database name from the main checkout's DB_DATABASE." >&2
        echo "  DB_DATABASE is left blank in .env; set it and re-run vendor/bin/worktree setup." >&2
    elif result="$($ENSURE_DB development "$DEV_DB" "$MAIN_DEV_DB")"; then
        echo "Using DB_DATABASE=$DEV_DB in .env"

        if [[ -n "$DEV_DB_MIGRATE_COMMAND" ]]; then
            echo "Running: $DEV_DB_MIGRATE_COMMAND"
            run_in_runtime sh -c "$DEV_DB_MIGRATE_COMMAND" || echo "Warning: migrate command failed." >&2
        fi
        # Seeding isn't idempotent, so only seed a database this run created.
        if [[ -n "$DEV_DB_SEED_COMMAND" && "$result" == *" created" ]]; then
            echo "Running: $DEV_DB_SEED_COMMAND"
            run_in_runtime sh -c "$DEV_DB_SEED_COMMAND" || echo "Warning: seed command failed." >&2
        fi
    else
        echo "Warning: Could not create the development database '$DEV_DB' — check DB_* settings in .env." >&2
        echo "  .env already points at it; re-run vendor/bin/worktree setup once fixed." >&2
    fi
fi

# ---------------------------------------------------------------------------
# 7. Install JavaScript dependencies
# ---------------------------------------------------------------------------
# A new worktree has no node_modules, so Vite and the like can't build
# without this. Skipped for projects without a package.json, and only warns
# on failure (e.g. no Node in the runtime image).
if [[ -f "$PROJECT_ROOT/package.json" ]]; then
    if [[ -f "$PROJECT_ROOT/pnpm-lock.yaml" ]]; then
        JS_INSTALL=(pnpm install)
    elif [[ -f "$PROJECT_ROOT/yarn.lock" ]]; then
        JS_INSTALL=(yarn install)
    elif [[ -f "$PROJECT_ROOT/bun.lock" || -f "$PROJECT_ROOT/bun.lockb" ]]; then
        JS_INSTALL=(bun install)
    else
        JS_INSTALL=(npm install --no-progress)
    fi
    echo ""
    echo "Installing JavaScript dependencies (${JS_INSTALL[0]})..."
    run_in_runtime "${JS_INSTALL[@]}" || echo "Warning: ${JS_INSTALL[*]} failed; run it with vendor/bin/worktree ${JS_INSTALL[*]}" >&2
fi

# ---------------------------------------------------------------------------
# 8. Project-specific setup
# ---------------------------------------------------------------------------
# E.g. npm run build: public/build is git-ignored, so a new worktree has no
# Vite manifest for tests that render @vite. Only warns on failure.
if [[ -n "$POST_SETUP_COMMAND" ]]; then
    echo ""
    echo "Running: $POST_SETUP_COMMAND"
    run_in_runtime sh -c "$POST_SETUP_COMMAND" || echo "Warning: $POST_SETUP_COMMAND failed." >&2
fi

# ---------------------------------------------------------------------------
# 9. Prune merged and idle worktrees
# ---------------------------------------------------------------------------
# In the background, so `git worktree add` doesn't wait on it, and without
# a fetch or a prompt. Its output goes to a log in the git dir.
if [[ "${WORKTREE_PRUNE_ON_SETUP:-true}" == true ]]; then
    PRUNE_LOG="$COMMON_GIT_DIR/worktree-isolation/prune.log"
    mkdir -p "${PRUNE_LOG%/*}"
    nohup bash "$SCRIPT_DIR/worktree-prune" --auto --no-fetch > "$PRUNE_LOG" 2>&1 < /dev/null &
    echo ""
    echo "Removing merged and idle worktrees in the background (log: $PRUNE_LOG)."
fi

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
echo ""
warn_about_hooks_calling_sail "$PROJECT_ROOT" "$RUNTIME" "$SAIL_DOCKER"
echo "Worktree setup complete. You can now run tests with: vendor/bin/worktree test"
