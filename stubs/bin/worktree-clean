#!/usr/bin/env bash
#
# Drops the per-worktree databases of worktrees that no longer exist. Setup
# and test record each worktree's databases (see record_database), so only
# those are ever dropped.
#
# Invoked as `vendor/bin/worktree clean` (stubs/bin/worktree dispatches
# straight into this file) and by worktree-prune; not itself exposed as a
# Composer bin.
#
# Usage:
#   vendor/bin/worktree clean
#   vendor/bin/worktree clean --all
#   vendor/bin/worktree clean --force
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_worktree-lib.sh"

usage() {
    cat <<'HELP'
Usage: vendor/bin/worktree clean [OPTIONS]

Drops the test and development databases of worktrees that no longer exist.
Only databases setup or test created for a worktree are dropped, never the
main checkout's.

Options:
  --all     Drop every worktree's databases, existing worktrees' too
  --force   Drop them without confirmation
  --help    Show this help
HELP
}

ALL=false
FORCE=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --all) ALL=true ;;
        --force) FORCE=true ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "Error: Unknown option '$1'." >&2
            echo "" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

load_worktree_config
LEDGER="$(database_ledger_dir)"

# ---------------------------------------------------------------------------
# Find the databases to drop
# ---------------------------------------------------------------------------
PROTECTED=" $(main_test_database) $(main_dev_database) "
TEST_NAMES=()
DEV_NAMES=()
for file in "$LEDGER"/*; do
    [[ -f "$file" ]] || continue
    [[ "$ALL" == true || ! -d "$COMMON_GIT_DIR/worktrees/$(basename "$file")" ]] || continue
    while IFS=$'\t' read -r kind name; do
        [[ -n "$name" && "$PROTECTED" != *" $name "* ]] || continue
        case "$kind" in
            test) TEST_NAMES+=("$name") ;;
            development) DEV_NAMES+=("$name") ;;
        esac
    done < "$file"
done

if [[ ${#TEST_NAMES[@]} -eq 0 && ${#DEV_NAMES[@]} -eq 0 ]]; then
    echo "No databases of removed worktrees to drop."
    exit 0
fi

echo "Databases to drop:"
for name in ${TEST_NAMES[@]+"${TEST_NAMES[@]}"} ${DEV_NAMES[@]+"${DEV_NAMES[@]}"}; do
    echo "  - $name"
done
echo ""

if [[ "$FORCE" != true ]]; then
    printf 'Drop these databases? [y/N] '
    read -r answer || answer=""
    if [[ ! "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]; then
        echo "Aborted."
        exit 0
    fi
fi

# ---------------------------------------------------------------------------
# Drop them
# ---------------------------------------------------------------------------
# DB_HOST is often a Compose service name (e.g. "mysql") that only resolves
# inside the Docker runtime, so the dropping runs there.
if in_runtime; then
    RUNTIME=native
else
    validate_runtime
    if [[ "$RUNTIME" == docker-compose ]] && in_main_checkout; then
        require_compose_service_running
    fi
fi

# Usage: forget_database NAME
forget_database() {
    local file
    for file in "$LEDGER"/*; do
        [[ -f "$file" ]] || continue
        awk -F '\t' -v name="$1" '$2 != name' "$file" > "$file.$$"
        if [[ -s "$file.$$" ]]; then
            mv "$file.$$" "$file"
        else
            rm -f "$file" "$file.$$"
        fi
    done
}

# Usage: drop_databases test|development NAME...
# Connects with the settings the main checkout uses for that kind.
drop_databases() {
    local kind="$1" output line status=0
    shift
    db_env_args "$kind" "$MAIN_DIR"
    if ! output="$(run_in_runtime ${DB_ENV[@]+"${DB_ENV[@]}"} -e "DROP_DATABASES=$*" php -r "$DROP_DB_PHP" 2>&1)"; then
        echo "Error: could not drop the $kind databases." >&2
        printf '  %s\n' "$output" >&2
        return 1
    fi
    while IFS= read -r line; do
        case "$line" in
            "dropped "*)
                echo "  Dropped: ${line#dropped }"
                forget_database "${line#dropped }"
                ;;
            "failed "*)
                echo "  Error: ${line#failed }" >&2
                status=1
                ;;
        esac
    done <<< "$output"
    return "$status"
}

STATUS=0
if [[ ${#TEST_NAMES[@]} -gt 0 ]]; then
    drop_databases test "${TEST_NAMES[@]}" || STATUS=1
fi
if [[ ${#DEV_NAMES[@]} -gt 0 ]]; then
    drop_databases development "${DEV_NAMES[@]}" || STATUS=1
fi
exit "$STATUS"
