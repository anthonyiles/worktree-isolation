#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Cleanup script for per-worktree test and development databases. Invoked as
 * `vendor/bin/worktree clean` (stubs/bin/worktree dispatches straight into
 * this file); not itself exposed as a Composer bin.
 *
 * No framework dependencies — uses only PDO.
 * Laravel projects can also use `php artisan worktree:clean` which delegates here.
 *
 * Reads DB credentials from .env.testing (test) and .env (development).
 *
 * Usage:
 *   vendor/bin/worktree clean
 *   vendor/bin/worktree clean --stale
 *   vendor/bin/worktree clean --force
 */

use WorktreeIsolation\DevDatabaseResolver;
use WorktreeIsolation\TestDatabaseResolver;
use WorktreeIsolation\WorktreeDatabaseResolver;

// Loaded directly: this script runs without the package autoloader.
require_once __DIR__ . '/../../src/WorktreeDatabaseResolver.php';
require_once __DIR__ . '/../../src/TestDatabaseResolver.php';
require_once __DIR__ . '/../../src/DevDatabaseResolver.php';

$opts = parseOptions(array_slice($argv, 1));

if (isset($opts['help'])) {
    fwrite(STDOUT, usage());
    exit(0);
}

$force = isset($opts['force']);
$stale = isset($opts['stale']);
$projectDir = $opts['project-dir'] ?? resolveProjectRoot();

$configFile = "$projectDir/.worktree-isolation.env";
if (! file_exists($configFile)) {
    fwrite(STDERR, "Error: $configFile not found. Run vendor/bin/worktree install first.\n");
    exit(1);
}
$conf = parseEnvFile($configFile);

$mainDir = mainCheckoutDir($projectDir);
$targets = cleanupTargets($conf, $mainDir);
$protected = protectedDatabases($conf, $mainDir);

if ($stale) {
    $worktrees = liveWorktreeBasenames($mainDir);
    if ($worktrees === null) {
        fwrite(STDERR, "Error: Could not list this repository's worktrees, so --stale can't tell which databases are in use.\n");
        exit(1);
    }
    foreach ($targets as &$target) {
        $target['protected'] = inUseDatabases($target['resolver'], $target['base'], $worktrees);
    }
    unset($target);
}

$found = [];
$exitCode = 0;
foreach ($targets as $target) {
    $env = $target['env'];
    $host = $env['DB_HOST'] ?? '127.0.0.1';
    $port = (int) ($env['DB_PORT'] ?? 3306);

    try {
        $pdo = new PDO("mysql:host=$host;port=$port", $env['DB_USERNAME'] ?? '', $env['DB_PASSWORD'] ?? '', [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        ]);
    } catch (PDOException $e) {
        fwrite(STDERR, "Error: Could not connect to the {$target['label']} database server at $host:$port\n");
        fwrite(STDERR, "  " . $e->getMessage() . "\n\n");
        fwrite(STDERR, "  Check DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD in {$target['file']}\n\n");
        $exitCode = 1;
        continue;
    }

    $stmt = $pdo->prepare('SELECT schema_name FROM information_schema.schemata WHERE schema_name LIKE ?');
    $stmt->execute([$target['pattern']]);
    $databases = array_values(array_diff($stmt->fetchAll(PDO::FETCH_COLUMN), $protected, $target['protected'] ?? [], array_column($found, 1)));

    if (empty($databases)) {
        $kind = $stale ? 'stale per-worktree' : 'per-worktree';
        echo "No $kind {$target['label']} databases found (pattern: {$target['pattern']}).\n";
        continue;
    }

    echo 'Found ' . count($databases) . " per-worktree {$target['label']} database(s):\n";
    foreach ($databases as $name) {
        echo "  - $name\n";
        $found[] = [$pdo, $name];
    }
    echo "\n";
}

if (empty($found)) {
    exit($exitCode);
}

if (! $force) {
    echo 'Drop all of these databases? [y/N] ';
    $answer = trim(fgets(STDIN) ?: '');
    if (! in_array(strtolower($answer), ['y', 'yes'], true)) {
        echo "Aborted.\n";
        exit($exitCode);
    }
}

$dropped = 0;
foreach ($found as [$pdo, $name]) {
    if (preg_match('/^[a-z0-9_-]+$/', $name) !== 1) {
        echo "  Skipping: $name (contains invalid characters)\n";
        continue;
    }

    try {
        $pdo->exec(sprintf('DROP DATABASE `%s`', $name));
        echo "  Dropped: $name\n";
        $dropped++;
    } catch (PDOException $e) {
        fwrite(STDERR, "  Error dropping $name: " . $e->getMessage() . "\n");
    }
}

echo "\nDone. $dropped database(s) removed.\n";
exit($exitCode);

// ---------------------------------------------------------------------------
// Functions
// ---------------------------------------------------------------------------

function usage(): string
{
    return <<<'HELP'
    Usage: vendor/bin/worktree clean [OPTIONS]

    Drops all per-worktree test databases ("{base}_wt_*", from .env.testing)
    and development databases ("{base}_wt_*", from .env). The main
    checkout's own databases are never dropped.

    Options:
      --force            Drop databases without confirmation
      --stale            Only drop databases whose worktree no longer exists
      --project-dir=PATH Project root (default: auto-detected)
      --help             Show this help

    HELP;
}

/**
 * Unlike getopt(), rejects anything it doesn't know: a mistyped --stale
 * must not leave a bare --force dropping every database.
 *
 * @param  list<string>  $args
 * @return array<string, string|true>
 */
function parseOptions(array $args): array
{
    $opts = [];
    while ($args !== []) {
        $arg = array_shift($args);
        if (in_array($arg, ['--force', '--stale', '--help'], true)) {
            $opts[substr($arg, 2)] = true;
        } elseif (str_starts_with($arg, '--project-dir=')) {
            $opts['project-dir'] = substr($arg, strlen('--project-dir='));
        } elseif ($arg === '--project-dir') {
            if ($args === []) {
                fwrite(STDERR, "Error: --project-dir requires a value.\n");
                exit(1);
            }
            $opts['project-dir'] = array_shift($args);
        } else {
            fwrite(STDERR, "Error: Unknown option '$arg'.\n\n" . usage());
            exit(1);
        }
    }

    return $opts;
}

function resolveProjectRoot(): string
{
    // This script runs from inside vendor/, not the project root —
    // resolve via git instead.
    $toplevel = trim((string) shell_exec('git rev-parse --show-toplevel 2>/dev/null'));

    return $toplevel !== '' ? $toplevel : getcwd();
}

function mainCheckoutDir(string $projectDir): string
{
    $commonDir = trim((string) shell_exec(
        'git -C ' . escapeshellarg($projectDir) . ' rev-parse --path-format=absolute --git-common-dir 2>/dev/null'
    ));

    return $commonDir !== '' ? dirname($commonDir) : $projectDir;
}

/**
 * Bases come from the main checkout's env files, which hold the plain names
 * every worktree's are derived from.
 *
 * @param  array<string, string>  $conf
 * @return list<array{label: string, resolver: class-string, base: string, file: string, env: array<string, string>, pattern: string}>
 */
function cleanupTargets(array $conf, string $mainDir): array
{
    $targets = [];

    // Same lookup order as main_test_database() in _worktree-lib.sh.
    $testingFile = $conf['WORKTREE_TESTING_ENV_FILE'] ?? '.env.testing';
    $testingExample = $conf['WORKTREE_TESTING_ENV_EXAMPLE'] ?? '.env.testing.example';
    $testingEnv = parseEnvFile("$mainDir/$testingFile") ?: parseEnvFile("$mainDir/$testingExample");
    $testBase = databaseBase($testingEnv) ?: 'testing';
    if (isMysqlConnection($testingEnv)) {
        $targets[] = target('test', TestDatabaseResolver::class, $testBase, $testingFile, $testingEnv);
    }

    $devEnabled = in_array($conf['WORKTREE_DEV_DB_PER_WORKTREE'] ?? 'false', ['true', '1'], true);
    $devEnv = parseEnvFile("$mainDir/.env");
    $devBase = databaseBase($devEnv);
    if ($devEnabled && $devBase !== '' && isMysqlConnection($devEnv)) {
        $targets[] = target('development', DevDatabaseResolver::class, $devBase, '.env', $devEnv);
    }

    return $targets;
}

/**
 * @param  class-string  $resolver
 * @param  array<string, string>  $env
 * @return array{label: string, resolver: class-string, base: string, file: string, env: array<string, string>, pattern: string}
 */
function target(string $label, string $resolver, string $base, string $file, array $env): array
{
    return [
        'label' => $label,
        'resolver' => $resolver,
        'base' => $base,
        'file' => $file,
        'env' => $env,
        'pattern' => escapeLike($base . WorktreeDatabaseResolver::MARKER) . '%',
    ];
}

/**
 * @param  array<string, string>  $env
 */
function databaseBase(array $env): string
{
    return explode(WorktreeDatabaseResolver::MARKER, $env['DB_DATABASE'] ?? '', 2)[0];
}

/**
 * Basenames of the worktrees that still exist; null when git can't list them.
 * A worktree whose directory is gone ("prunable") doesn't count.
 *
 * @return list<string>|null
 */
function liveWorktreeBasenames(string $mainDir): ?array
{
    exec('git -C ' . escapeshellarg($mainDir) . ' worktree list --porcelain 2>/dev/null', $lines, $exitCode);
    if ($exitCode !== 0) {
        return null;
    }

    $basenames = [];
    // The first entry is the main checkout.
    foreach (array_slice(preg_split('/\n\s*\n/', trim(implode("\n", $lines))), 1) as $entry) {
        if (preg_match('/^worktree (.+)$/m', $entry, $m) === 1 && preg_match('/^prunable\b/m', $entry) !== 1) {
            $basenames[] = basename($m[1]);
        }
    }

    return $basenames;
}

/**
 * @param  class-string<WorktreeDatabaseResolver>  $resolver
 * @param  list<string>  $worktrees
 * @return list<string>
 */
function inUseDatabases(string $resolver, string $base, array $worktrees): array
{
    $names = [];
    foreach ($worktrees as $worktree) {
        try {
            $names[] = $resolver::derive($base, $worktree);
        } catch (InvalidArgumentException) {
            // No name can be derived, so no database of this worktree exists.
        }
    }

    return $names;
}

/**
 * @param  array<string, string>  $conf
 * @return list<string>
 */
function protectedDatabases(array $conf, string $mainDir): array
{
    $files = ['.env', $conf['WORKTREE_TESTING_ENV_FILE'] ?? '.env.testing', $conf['WORKTREE_TESTING_ENV_EXAMPLE'] ?? '.env.testing.example'];

    return array_values(array_filter(array_map(
        fn (string $file) => parseEnvFile("$mainDir/$file")['DB_DATABASE'] ?? '',
        $files
    )));
}

function isMysqlConnection(array $env): bool
{
    return in_array($env['DB_CONNECTION'] ?? '', ['mysql', 'mariadb'], true);
}

function escapeLike(string $value): string
{
    return addcslashes($value, '%_\\');
}

// Same rules as parse_env_value() in _worktree-lib.sh: optional "export ",
// a quoted value up to its closing quote, else the value minus a trailing
// " # comment".
function parseEnvFile(string $path): array
{
    $env = [];
    if (! file_exists($path)) {
        return $env;
    }

    foreach (file($path, FILE_IGNORE_NEW_LINES) as $line) {
        if (preg_match('/^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$/', rtrim($line, "\r"), $m) !== 1) {
            continue;
        }
        $value = ltrim($m[2]);
        if (preg_match('/^(["\'])(.*?)\1/', $value, $quoted) === 1 || preg_match('/^(["\'])(.*)$/', $value, $quoted) === 1) {
            $env[$m[1]] = $quoted[2];
        } else {
            $env[$m[1]] = rtrim(preg_replace('/\s#.*$/', '', $value) ?? '');
        }
    }

    return $env;
}
