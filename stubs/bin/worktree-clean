#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Cleanup script for per-worktree test and development databases. Invoked as
 * `vendor/bin/worktree clean` (stubs/bin/worktree dispatches straight into
 * this file); not itself exposed as a Composer bin.
 *
 * No framework dependencies — uses only PDO.
 * Laravel projects can also use `php artisan worktree:clean` which delegates here.
 *
 * Reads DB credentials from .env.testing (test) and .env (development).
 *
 * Usage:
 *   vendor/bin/worktree clean
 *   vendor/bin/worktree clean --force
 */

// Must match WorktreeIsolation\DevDatabaseResolver::MARKER; this script
// runs without the package autoloader.
const DEV_DB_MARKER = '_wt_';

$opts = getopt('', ['force', 'project-dir:', 'help']);

if (isset($opts['help'])) {
    fwrite(STDOUT, <<<HELP
    Usage: vendor/bin/worktree clean [OPTIONS]

    Drops all per-worktree test databases ("{base}-*", from .env.testing) and
    development databases ("{base}_wt_*", from .env).

    Options:
      --force            Drop databases without confirmation
      --project-dir=PATH Project root (default: auto-detected)
      --help             Show this help

    HELP);
    exit(0);
}

$force = isset($opts['force']);
$projectDir = $opts['project-dir'] ?? resolveProjectRoot();

$targets = cleanupTargets($projectDir);

$found = [];
foreach ($targets as $target) {
    $env = $target['env'];
    $host = $env['DB_HOST'] ?? '127.0.0.1';
    $port = (int) ($env['DB_PORT'] ?? 3306);

    try {
        $pdo = new PDO("mysql:host=$host;port=$port", $env['DB_USERNAME'] ?? '', $env['DB_PASSWORD'] ?? '', [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        ]);
    } catch (PDOException $e) {
        fwrite(STDERR, "Error: Could not connect to database at $host:$port\n");
        fwrite(STDERR, "  " . $e->getMessage() . "\n\n");
        fwrite(STDERR, "  Check DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD in {$target['file']}\n");
        exit(1);
    }

    $stmt = $pdo->prepare('SELECT schema_name FROM information_schema.schemata WHERE schema_name LIKE ?');
    $stmt->execute([$target['pattern']]);
    $databases = $stmt->fetchAll(PDO::FETCH_COLUMN);

    if (empty($databases)) {
        echo "No per-worktree {$target['label']} databases found (pattern: {$target['pattern']}).\n";
        continue;
    }

    echo 'Found ' . count($databases) . " per-worktree {$target['label']} database(s):\n";
    foreach ($databases as $name) {
        echo "  - $name\n";
        $found[] = [$pdo, $name];
    }
    echo "\n";
}

if (empty($found)) {
    exit(0);
}

if (! $force) {
    echo 'Drop all of these databases? [y/N] ';
    $answer = trim(fgets(STDIN) ?: '');
    if (! in_array(strtolower($answer), ['y', 'yes'], true)) {
        echo "Aborted.\n";
        exit(0);
    }
}

$dropped = 0;
foreach ($found as [$pdo, $name]) {
    if (preg_match('/^[a-z0-9_-]+$/', $name) !== 1) {
        echo "  Skipping: $name (contains invalid characters)\n";
        continue;
    }

    try {
        $pdo->exec(sprintf('DROP DATABASE `%s`', $name));
        echo "  Dropped: $name\n";
        $dropped++;
    } catch (PDOException $e) {
        fwrite(STDERR, "  Error dropping $name: " . $e->getMessage() . "\n");
    }
}

echo "\nDone. $dropped database(s) removed.\n";
exit(0);

// ---------------------------------------------------------------------------
// Functions
// ---------------------------------------------------------------------------

function resolveProjectRoot(): string
{
    // This script runs from inside vendor/, not the project root —
    // resolve via git instead.
    $toplevel = trim((string) shell_exec('git rev-parse --show-toplevel 2>/dev/null'));

    return $toplevel !== '' ? $toplevel : getcwd();
}

/**
 * @return list<array{label: string, file: string, env: array<string, string>, pattern: string}>
 */
function cleanupTargets(string $projectDir): array
{
    $conf = parseEnvFile("$projectDir/.worktree-isolation.env");

    $testingFile = $conf['WORKTREE_TESTING_ENV_FILE'] ?? '.env.testing';
    $testingEnv = parseEnvFile("$projectDir/$testingFile");
    $targets = [[
        'label' => 'test',
        'file' => $testingFile,
        'env' => $testingEnv,
        'pattern' => escapeLike(testDatabaseBase($testingEnv['DB_DATABASE'] ?? 'testing', $projectDir)) . '-%',
    ]];

    $devEnabled = in_array($conf['WORKTREE_DEV_DB_PER_WORKTREE'] ?? 'false', ['true', '1'], true);
    $devEnv = parseEnvFile("$projectDir/.env");
    $devBase = explode(DEV_DB_MARKER, $devEnv['DB_DATABASE'] ?? '', 2)[0];
    if ($devEnabled && $devBase !== '' && in_array($devEnv['DB_CONNECTION'] ?? '', ['mysql', 'mariadb'], true)) {
        $targets[] = [
            'label' => 'development',
            'file' => '.env',
            'env' => $devEnv,
            'pattern' => escapeLike($devBase . DEV_DB_MARKER) . '%',
        ];
    }

    return $targets;
}

/**
 * Setup writes a worktree's own derived name ("{base}-{worktree}") into its
 * .env.testing, so strip that back to the base to match every worktree's.
 */
function testDatabaseBase(string $name, string $projectDir): string
{
    if (! is_file("$projectDir/.git")) {
        return $name;
    }

    // Must match WorktreeIsolation\TestDatabaseResolver::worktreeSuffix().
    $suffix = trim(preg_replace('/[^a-z0-9]+/', '-', strtolower(basename($projectDir))) ?? '', '-');
    $suffix = '-' . ($suffix === '' ? 'worktree' : $suffix);

    return str_ends_with($name, $suffix) ? substr($name, 0, -strlen($suffix)) : $name;
}

function escapeLike(string $value): string
{
    return addcslashes($value, '%_\\');
}

function parseEnvFile(string $path): array
{
    $env = [];
    if (! file_exists($path)) {
        return $env;
    }

    $lines = file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);

    foreach ($lines as $line) {
        $line = trim($line);
        if ($line === '' || str_starts_with($line, '#')) {
            continue;
        }
        $pos = strpos($line, '=');
        if ($pos === false) {
            continue;
        }
        $key = trim(substr($line, 0, $pos));
        $value = trim(substr($line, $pos + 1));
        $env[$key] = trim($value, '"\'');
    }

    return $env;
}
