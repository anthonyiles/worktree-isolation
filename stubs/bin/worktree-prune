#!/usr/bin/env bash
#
# Removes worktrees whose branch is merged or that have been idle for
# WORKTREE_PRUNE_AFTER days, and worktrees whose directory is gone, along
# with their Compose stacks and databases. Local branches are kept, so
# `git worktree add <path> <branch>` brings a worktree back.
#
# Invoked as `vendor/bin/worktree prune` (stubs/bin/worktree dispatches
# straight into this file) and, with --auto, in the background at the end of
# worktree-setup; not itself exposed as a Composer bin.
#
# Usage:
#   vendor/bin/worktree prune
#   vendor/bin/worktree prune --dry-run
#   vendor/bin/worktree prune --force
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_worktree-lib.sh"

usage() {
    cat <<'HELP'
Usage: vendor/bin/worktree prune [OPTIONS]

Removes worktrees whose branch is merged into origin's default branch (or
origin/$WORKTREE_PRUNE_BRANCH) or that have had no git activity for
WORKTREE_PRUNE_AFTER days (default 7, 0 to never), and worktrees whose
directory is gone, along with their Compose stacks and databases. Local
branches are kept. The current worktree, and worktrees that are locked,
detached or have uncommitted or untracked changes, are never removed.

Options:
  --dry-run   Only list them
  --force     Remove them without confirmation
  --no-fetch  Use the local origin refs instead of fetching first
  --auto      Remove them without confirmation, at most once an hour (setup
              runs this)
  --help      Show this help
HELP
}

MODE=ask
FETCH=true
AUTO=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) MODE=report ;;
        --force) MODE=remove ;;
        --no-fetch) FETCH=false ;;
        --auto)
            AUTO=true
            MODE=remove
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "Error: Unknown option '$1'." >&2
            echo "" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

load_worktree_config
IDLE_DAYS="${WORKTREE_PRUNE_AFTER:-7}"
if [[ ! "$IDLE_DAYS" =~ ^[0-9]+$ ]]; then
    echo "Error: WORKTREE_PRUNE_AFTER must be a number of days, not '$IDLE_DAYS'." >&2
    exit 1
fi

# Setup runs this for every new worktree; once an hour is plenty.
if [[ "$AUTO" == true ]]; then
    STAMP="$COMMON_GIT_DIR/worktree-isolation/last-prune"
    if [[ -f "$STAMP" && -n "$(find "$STAMP" -mmin -60)" ]]; then
        exit 0
    fi
    mkdir -p "${STAMP%/*}"
    touch "$STAMP"
fi

if [[ "$FETCH" == true ]]; then
    git fetch --prune --quiet origin || echo "Warning: git fetch failed; using the local origin refs." >&2
fi
BASE_REF="$(prune_base_ref)"
if ! git rev-parse --verify --quiet "$BASE_REF^{commit}" > /dev/null; then
    echo "Error: Could not find $BASE_REF. Set WORKTREE_PRUNE_BRANCH in .worktree-isolation.env, or origin's default branch with: git remote set-head origin --auto" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Find the worktrees to remove
# ---------------------------------------------------------------------------
CURRENT="$(cd -P "$PROJECT_ROOT" && pwd)"
PATHS=()
IDS=()
REASONS=()
KEPT=()

load_worktree_list
for ((i = 0; i < ${#WT_PATHS[@]}; i++)); do
    path="${WT_PATHS[i]}"
    branch="${WT_BRANCHES[i]}"
    case "${WT_STATES[i]}" in
        locked)
            continue
            ;;
        prunable)
            PATHS+=("$path")
            IDS+=("${WT_IDS[i]}")
            REASONS+=("directory is gone")
            continue
            ;;
    esac
    [[ -n "$branch" && "$(cd -P "$path" && pwd)" != "$CURRENT" ]] || continue
    if is_merged "$branch" "$BASE_REF"; then
        reason="$branch is merged into $BASE_REF"
    elif [[ "$IDLE_DAYS" -gt 0 ]] && idle_for "$IDLE_DAYS" "${WT_IDS[i]}"; then
        reason="no git activity for $IDLE_DAYS days; $branch is kept"
    else
        continue
    fi
    if [[ -n "$(git -C "$path" status --porcelain)" ]]; then
        KEPT+=("$path ($reason, but the worktree has uncommitted or untracked changes)")
        continue
    fi
    PATHS+=("$path")
    IDS+=("${WT_IDS[i]}")
    REASONS+=("$reason")
done

for kept in ${KEPT[@]+"${KEPT[@]}"}; do
    echo "Keeping $kept"
done

if [[ ${#PATHS[@]} -eq 0 ]]; then
    echo "No worktrees to remove."
    exit 0
fi

echo "Worktrees to remove:"
for ((i = 0; i < ${#PATHS[@]}; i++)); do
    echo "  - ${PATHS[i]} (${REASONS[i]})"
done
echo ""

# Only ask on a terminal; anywhere else, only list them.
if [[ "$MODE" == ask && ! -t 0 ]]; then
    MODE=report
fi
if [[ "$MODE" == ask ]]; then
    printf 'Remove these worktrees, their Compose stacks and databases? [y/N] '
    read -r answer || answer=""
    if [[ ! "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]; then
        echo "Aborted."
        exit 0
    fi
fi
if [[ "$MODE" == report ]]; then
    echo "Remove them with: vendor/bin/worktree prune --force"
    exit 0
fi

# ---------------------------------------------------------------------------
# Remove them
# ---------------------------------------------------------------------------
if [[ "$RUNTIME" == docker-compose ]]; then
    validate_runtime
    COMPOSE_BASE="$(compose_project_base)"
fi

STATUS=0
REMOVED=0
for ((i = 0; i < ${#PATHS[@]}; i++)); do
    path="${PATHS[i]}"
    if [[ "$RUNTIME" == docker-compose ]]; then
        project="$(derive_compose_project_name "$COMPOSE_BASE" "$(worktree_key "${IDS[i]}")")"
        # Run from the main checkout: the worktree's directory may be gone.
        if ! (cd "$MAIN_DIR" && docker compose ${WORKTREE_COMPOSE_FILE:+-f "$WORKTREE_COMPOSE_FILE"} -p "$project" down -v --remove-orphans); then
            echo "Error: Could not remove the Compose stack $project, so $path is kept." >&2
            STATUS=1
            continue
        fi
    fi
    if [[ -d "$path" ]] && ! git worktree remove "$path"; then
        STATUS=1
        continue
    fi
    echo "Removed $path"
    REMOVED=$((REMOVED + 1))
done
git worktree prune

# Drop the databases recorded for the worktrees that are now gone, through
# this checkout's runtime.
if [[ "$REMOVED" -gt 0 ]]; then
    echo ""
    bash "$SCRIPT_DIR/worktree-clean" --force || STATUS=1
fi
exit "$STATUS"
