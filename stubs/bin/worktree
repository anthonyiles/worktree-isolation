#!/usr/bin/env bash
#
# Unified entrypoint for worktree isolation, Sail-style: every operation goes
# through this one command instead of remembering four separate script names.
#
# Known subcommands delegate to their dedicated script:
#   vendor/bin/worktree install [args...]   -> worktree-install
#   vendor/bin/worktree setup               -> worktree-setup
#   vendor/bin/worktree test [args...]      -> test
#   vendor/bin/worktree clean [args...]     -> worktree-clean
#
# Anything else is passed straight through into this worktree's configured
# runtime (native host, docker-compose service, or docker-image container) —
# e.g. `composer require foo/bar`, `npm run dev`, `php artisan migrate`.
#
# Alias this for a Sail-like feel:
#   alias worktree='vendor/bin/worktree'
#   worktree test
#   worktree composer install
#   worktree npm run dev
#
set -euo pipefail

# vendor/bin/worktree is a Composer-managed symlink, so ${BASH_SOURCE[0]}
# points at the symlink, not the real file next to the sibling scripts.
# readlink -f isn't portable (no -f on macOS's stock readlink), so resolve it
# manually. (Duplicated in worktree-setup/test rather than shared via
# _worktree-lib.sh: resolving *this* script's own symlink has to happen
# before we know where the lib even is.)
resolve_script_dir() {
    local src="${BASH_SOURCE[0]}"
    while [[ -h "$src" ]]; do
        local dir
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(resolve_script_dir)"

if [[ $# -eq 0 ]]; then
    echo "Usage: vendor/bin/worktree <command> [args...]" >&2
    echo "" >&2
    echo "Known commands: install, setup, test, clean" >&2
    echo "Anything else runs inside this worktree's configured runtime" >&2
    echo "(e.g. composer install, npm run dev, php artisan migrate)." >&2
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
    install)
        exec "$SCRIPT_DIR/worktree-install" "$@"
        ;;
    setup)
        exec "$SCRIPT_DIR/worktree-setup" "$@"
        ;;
    test)
        exec "$SCRIPT_DIR/test" "$@"
        ;;
    clean)
        exec "$SCRIPT_DIR/worktree-clean" "$@"
        ;;
esac

# ---------------------------------------------------------------------------
# Passthrough: run "$COMMAND $@" inside this worktree's runtime target.
# ---------------------------------------------------------------------------
# git sets cwd to the worktree root, so this resolves correctly even though
# the script itself lives in vendor/.
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
WORKTREE_BASENAME="$(basename "$PROJECT_ROOT")"

CONF_FILE="$PROJECT_ROOT/.worktree-isolation.env"
if [[ -f "$CONF_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$CONF_FILE"
    set +a
fi

# shellcheck disable=SC1091
source "$SCRIPT_DIR/_worktree-lib.sh"

RUNTIME="${WORKTREE_RUNTIME:-native}"
TESTING_ENV_FILE="${WORKTREE_TESTING_ENV_FILE:-.env.testing}"
# shellcheck disable=SC2034 # read by build_docker_image_args in _worktree-lib.sh
DB_PER_WORKTREE_KEY="${WORKTREE_DB_PER_WORKTREE_KEY:-TEST_DB_PER_WORKTREE}"

# docker-image driver settings
IMAGE="${WORKTREE_DOCKER_IMAGE:-}"
# shellcheck disable=SC2034
NETWORK="${WORKTREE_DOCKER_NETWORK:-}"
# shellcheck disable=SC2034
WORKDIR="${WORKTREE_DOCKER_WORKDIR:-/var/www/html}"

# docker-compose driver settings
COMPOSE_SERVICE="${WORKTREE_COMPOSE_SERVICE:-app}"
COMPOSE_FILE_OPT=""
if [[ -n "${WORKTREE_COMPOSE_FILE:-}" ]]; then
    COMPOSE_FILE_OPT="-f $WORKTREE_COMPOSE_FILE"
fi
COMPOSE_PROJECT_BASE="${WORKTREE_COMPOSE_PROJECT_BASE:-$(basename "$PROJECT_ROOT")}"
COMPOSE_PROJECT_NAME="$(derive_compose_project_name "$COMPOSE_PROJECT_BASE" "$WORKTREE_BASENAME")"

# ---------------------------------------------------------------------------
# Validate runtime
# ---------------------------------------------------------------------------
case "$RUNTIME" in
    native)
        ;;
    docker-compose)
        if ! docker compose version > /dev/null 2>&1; then
            echo "Error: 'docker compose' not found. Install Docker with the Compose plugin." >&2
            exit 1
        fi
        ;;
    docker-image)
        if [[ -z "$IMAGE" ]]; then
            echo "Error: WORKTREE_DOCKER_IMAGE must be set for the docker-image runtime." >&2
            exit 1
        fi
        if ! docker image inspect "$IMAGE" > /dev/null 2>&1; then
            echo "Error: Docker image '$IMAGE' not found." >&2
            echo "Build it first (e.g. 'docker compose build' or 'vendor/bin/sail build')." >&2
            exit 1
        fi
        ;;
    *)
        echo "Error: Unknown WORKTREE_RUNTIME '$RUNTIME'. Use: native, docker-compose, or docker-image." >&2
        exit 1
        ;;
esac

# Load testing env vars (DB_*, etc.) so they can be forwarded to docker-image
# containers, same as vendor/bin/worktree test.
if [[ -f "$PROJECT_ROOT/$TESTING_ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$PROJECT_ROOT/$TESTING_ENV_FILE"
    set +a
fi

case "$RUNTIME" in
    native)
        exec "$COMMAND" "$@"
        ;;

    docker-compose)
        # -T disables the pseudo-tty, which breaks interactive commands
        # (npm run dev, php artisan tinker) but is required for non-TTY
        # contexts (CI, agents, piped output). Only allocate one when stdout
        # is actually a terminal.
        TTY_FLAG="-T"
        [[ -t 1 ]] && TTY_FLAG=""
        # shellcheck disable=SC2086
        exec docker compose -p "$COMPOSE_PROJECT_NAME" $COMPOSE_FILE_OPT exec $TTY_FLAG \
            "$COMPOSE_SERVICE" "$COMMAND" "$@"
        ;;

    docker-image)
        build_docker_image_args

        TTY_ARGS=()
        [[ -t 1 ]] && TTY_ARGS=(-it)

        # Overriding --entrypoint with the passthrough command's first token
        # is the same pattern worktree-setup uses per-command (--entrypoint
        # composer / --entrypoint npm), generalized to any command.
        exec "${DOCKER_ARGS[@]}" "${TTY_ARGS[@]}" --entrypoint "$COMMAND" "$IMAGE" "$@"
        ;;
esac
