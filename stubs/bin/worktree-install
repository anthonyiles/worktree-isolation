#!/usr/bin/env bash
#
# Installer for worktree isolation. Invoked as `vendor/bin/worktree install`
# (stubs/bin/worktree dispatches straight into this file); not itself
# exposed as a Composer bin.
#
# Plain bash, so it runs on hosts without PHP (e.g. Sail projects).
# Laravel projects can also use `php artisan worktree:install` which delegates here.
#
# Usage:
#   vendor/bin/worktree install
#   vendor/bin/worktree install --runtime=docker-compose --compose-service=app
#   vendor/bin/worktree install --runtime=docker-image --docker-image=myapp --docker-network=mynet
#   vendor/bin/worktree install --force
#   vendor/bin/worktree install --agents
#   vendor/bin/worktree install --agents=CLAUDE.md,AGENTS.md
#
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_worktree-lib.sh"

VALID_RUNTIMES=(native docker-compose docker-image)

usage() {
    cat <<'HELP'
Usage: vendor/bin/worktree install [OPTIONS]

Options:
  --runtime=DRIVER              Runtime driver: native, docker-compose, docker-image
                                 (default: docker-image when Laravel Sail is detected,
                                 else native)
  --docker-image=NAME           Docker image name (docker-image runtime)
  --docker-network=NAME         Docker network name (docker-image runtime)
  --compose-service=NAME        Docker Compose service name (docker-compose runtime, default: app)
  --compose-project-base=NAME   Docker Compose project base name (docker-compose runtime,
                                 default: derived from the project directory name)
  --test-command=CMD            Test command (default: php artisan test)
  --force                       Overwrite existing files
  --agents[=FILES]              Add worktree instructions for AI agents to FILES
                                 (comma-separated, default: whichever of AGENTS.md
                                 and CLAUDE.md exist, else AGENTS.md)
  --project-dir=PATH            Project root (default: auto-detected)
  --stubs-dir=PATH              Stubs directory (default: auto-detected from package)
  --help                        Show this help
HELP
}

# ---------------------------------------------------------------------------
# Functions
# ---------------------------------------------------------------------------

resolve_project_root() {
    # This script runs from inside vendor/, not the project root —
    # resolve via git instead.
    git rev-parse --show-toplevel 2> /dev/null || pwd
}

find_stubs_dir() {
    local dir
    for dir in "$1/vendor/anthonyiles/worktree-isolation/stubs" "$SCRIPT_DIR/.."; do
        if [[ -d "$dir" && -e "$dir/bin/test" ]]; then
            (cd -P "$dir" && pwd)
            return
        fi
    done
    return 1
}

# Sets SAIL_IMAGE and SAIL_NETWORK, or returns 1 when Sail isn't detected.
detect_sail() {
    local project_dir="$1" compose_file="" file
    [[ -e "$project_dir/vendor/bin/sail" ]] || return 1

    for file in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
        if [[ -e "$project_dir/$file" ]]; then
            compose_file="$project_dir/$file"
            break
        fi
    done
    [[ -n "$compose_file" ]] || return 1

    SAIL_IMAGE="$(grep -m 1 -E "^[[:space:]]*image:[[:space:]]*['\"]?sail-" "$compose_file" \
        | sed -E "s/^[[:space:]]*image:[[:space:]]*['\"]?(sail-[^'\"[:space:]]+).*/\1/")" || SAIL_IMAGE=""
    SAIL_NETWORK="$(compose_project_name "$project_dir")_sail"
}

# Mirrors Docker Compose's own default: COMPOSE_PROJECT_NAME from .env, else
# the directory name, lowercased with anything outside [a-z0-9_-] dropped.
compose_project_name() {
    local name
    name="$(env_file_value "$1/.env" COMPOSE_PROJECT_NAME)"
    [[ -n "$name" ]] || name="$(basename "$1")"

    printf '%s' "$name" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -cd 'a-z0-9_-' | sed -E 's/^[_-]+//'
}

verify_git_version() {
    local output major minor
    if ! output="$(git --version 2>&1)"; then
        echo "Error: Could not determine git version. Is git installed?" >&2
        return 1
    fi

    if [[ "${output%%$'\n'*}" =~ ([0-9]+)\.([0-9]+) ]]; then
        major="${BASH_REMATCH[1]}"
        minor="${BASH_REMATCH[2]}"
    else
        major=0
        minor=0
    fi

    if (( 10#$major < 2 || (10#$major == 2 && 10#$minor < 54) )); then
        echo "Error: Git 2.54+ is required for config-based hooks. You have Git $major.$minor." >&2
        if [[ "$(uname -s)" == Darwin ]]; then
            echo "  Upgrade with: brew upgrade git" >&2
        else
            echo "  Install a newer git from https://git-scm.com/downloads or your package manager." >&2
        fi
        return 1
    fi

    echo "  Git version: $major.$minor (OK)"
}

create_env_config() {
    local env_file="$PROJECT_DIR/.worktree-isolation.env"

    if [[ -e "$env_file" && "$FORCE" != true ]]; then
        echo "  Skipping: .worktree-isolation.env (already exists)"
        return
    fi

    local lines=(
        '# Worktree Isolation Configuration'
        '# These values are used by vendor/bin/worktree setup and vendor/bin/worktree test'
        ''
        '# Runtime driver: native | docker-compose | docker-image'
        "WORKTREE_RUNTIME=$RUNTIME_OPT"
        ''
        '# Test command (default: php artisan test)'
    )

    if [[ -n "${OPT_TEST_COMMAND:-}" ]]; then
        lines+=("WORKTREE_TEST_COMMAND=$OPT_TEST_COMMAND")
    else
        lines+=('# WORKTREE_TEST_COMMAND=php vendor/bin/phpunit')
    fi

    if [[ "$RUNTIME_OPT" == docker-compose ]]; then
        # slugify applies whether the base was auto-derived or passed via
        # --compose-project-base, so an explicit value can never produce an
        # invalid Compose project name.
        lines+=(
            ''
            '# docker-compose runtime settings'
            "WORKTREE_COMPOSE_SERVICE=${OPT_COMPOSE_SERVICE-app}"
            '# WORKTREE_COMPOSE_FILE=docker-compose.yml'
            "WORKTREE_COMPOSE_PROJECT_BASE=$(slugify "${OPT_COMPOSE_PROJECT_BASE-$(basename "$PROJECT_DIR")}")"
        )
    fi

    if [[ "$RUNTIME_OPT" == docker-image ]]; then
        local image="${OPT_DOCKER_IMAGE:-}" network="${OPT_DOCKER_NETWORK:-}"

        if [[ -z "$image" ]]; then
            echo "  Tip: Set WORKTREE_DOCKER_IMAGE in .worktree-isolation.env or pass --docker-image"
        fi
        if [[ -z "$network" ]]; then
            echo "  Tip: Set WORKTREE_DOCKER_NETWORK in .worktree-isolation.env or pass --docker-network"
        fi

        lines+=(
            ''
            '# docker-image runtime settings'
            "WORKTREE_DOCKER_IMAGE=$image"
            "WORKTREE_DOCKER_NETWORK=$network"
            '# WORKTREE_DOCKER_WORKDIR=/var/www/html'
        )
    fi

    lines+=(
        ''
        '# Testing env file copied into each worktree, and its fallback'
        '# WORKTREE_TESTING_ENV_FILE=.env.testing'
        '# WORKTREE_TESTING_ENV_EXAMPLE=.env.testing.example'
        ''
        '# Per-worktree development database (MySQL/MariaDB)'
        'WORKTREE_DEV_DB_PER_WORKTREE=true'
        '# WORKTREE_DEV_DB_MIGRATE_COMMAND=php artisan migrate --no-interaction'
        '# WORKTREE_DEV_DB_SEED_COMMAND=php artisan db:seed --no-interaction'
    )

    printf '%s\n' "${lines[@]}" > "$env_file"
    echo "  Created: .worktree-isolation.env"
}

# Single-quotes a value for the shell, the way PHP's escapeshellarg() does, so
# configs written by the earlier PHP installer stay byte-identical.
shell_quote() {
    local escaped="'\\''"
    printf "'%s'" "${1//\'/$escaped}"
}

configure_git_hooks() {
    # hook.*.command must be an absolute path: git resolves a relative one
    # against the cwd of whatever worktree is running the hook (the new
    # worktree, for post-checkout), not the main repo.
    # Run through bash so it works even when Composer didn't keep the
    # executable bit (zip dists without unzip).
    local hook_command
    hook_command="bash $(shell_quote "$STUBS_DIR/githooks/post-checkout-worktree-setup.sh")"

    if (cd "$PROJECT_DIR" \
        && git config --local hook.worktree-setup.command "$hook_command" \
        && git config --local --replace-all hook.worktree-setup.event post-checkout) > /dev/null; then
        echo "  Configured: hook.worktree-setup.command/event (local git config)"
    else
        echo "  Warning: Could not configure git hooks automatically."
        echo "  Run manually:"
        echo "    git config --local hook.worktree-setup.command $(shell_quote "$hook_command")"
        echo "    git config --local --replace-all hook.worktree-setup.event post-checkout"
    fi
}

# Usage: write_agent_instructions [FILES]  (no argument: pick the defaults)
write_agent_instructions() {
    local targets=() file
    if [[ $# -gt 0 ]]; then
        local listed=()
        IFS=',' read -ra listed <<< "$1"
        for file in ${listed[@]+"${listed[@]}"}; do
            file="$(printf '%s' "$file" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
            [[ -n "$file" ]] && targets+=("$file")
        done
    else
        default_agent_files
    fi

    for file in ${targets[@]+"${targets[@]}"}; do
        upsert_agent_block "$file"
    done

    if [[ $# -eq 0 && "${targets[*]}" == AGENTS.md && ! -e "$PROJECT_DIR/CLAUDE.md" ]]; then
        echo "  Tip: Claude Code reads CLAUDE.md, not AGENTS.md. Add a CLAUDE.md containing"
        echo "       @AGENTS.md, or re-run with --agents=AGENTS.md,CLAUDE.md"
    fi
}

# Sets targets (declared by the caller).
default_agent_files() {
    local file
    for file in AGENTS.md CLAUDE.md; do
        [[ -e "$PROJECT_DIR/$file" ]] && targets+=("$file")
    done

    if [[ ${#targets[@]} -eq 0 ]]; then
        targets=(AGENTS.md)
    # A CLAUDE.md that imports AGENTS.md already gets the block through it.
    elif [[ ${#targets[@]} -eq 2 ]] && grep -qF '@AGENTS.md' "$PROJECT_DIR/CLAUDE.md"; then
        targets=(AGENTS.md)
    fi
}

upsert_agent_block() {
    local file="$1"
    local path="$PROJECT_DIR/$file"
    local start='<!-- worktree-isolation:start -->'
    local end='<!-- worktree-isolation:end -->'
    local block
    block="$start"$'\n'"$(agent_instructions)"$'\n'"$end"

    if [[ ! -e "$path" ]]; then
        mkdir -p "$(dirname "$path")"
        printf '%s\n' "$block" > "$path"
        echo "  Created: $file (AI agent instructions)"
        return
    fi

    # The trailing x keeps $(...) from stripping the file's final newlines.
    local existing
    existing="$(cat "$path"; printf x)"
    existing="${existing%x}"

    # Replace the first start marker through the first end marker after it.
    if [[ "$existing" == *"$start"* ]]; then
        local before="${existing%%"$start"*}" rest="${existing#*"$start"}"
        if [[ "$rest" == *"$end"* ]]; then
            local updated="$before$block${rest#*"$end"}"
            if [[ "$updated" == "$existing" ]]; then
                echo "  Unchanged: $file (AI agent instructions already current)"
                return
            fi
            printf '%s' "$updated" > "$path"
            echo "  Updated: $file (AI agent instructions)"
            return
        fi
    fi

    local separator=""
    if [[ -n "$existing" ]]; then
        if [[ "$existing" == *$'\n' ]]; then
            separator=$'\n'
        else
            separator=$'\n\n'
        fi
    fi
    printf '%s\n' "$existing$separator$block" > "$path"
    echo "  Added: AI agent instructions to $file"
}

agent_instructions() {
    cat <<'MD'
## Git worktrees

Each git worktree of this project gets its own dependencies, env files and databases.
Inside a worktree (`.git` is a file, not a directory), run every command through
`vendor/bin/worktree`:

- `vendor/bin/worktree test`, not `php artisan test`, `sail test` or `phpunit`
- `vendor/bin/worktree composer install`, `vendor/bin/worktree npm run build`
- `vendor/bin/worktree php artisan migrate`

Never call `sail`, `docker compose`, `composer`, `npm` or `php artisan` directly in a
worktree: they can run in another checkout's container against its database. In the
main checkout, run commands as usual. Full guide:
`vendor/anthonyiles/worktree-isolation/docs/ai-agents.md`
MD
}

# ---------------------------------------------------------------------------
# Options
# ---------------------------------------------------------------------------
# Unset means "not passed". An empty value (e.g. --docker-image=) counts as
# not passed too, so defaults and Sail detection still apply.
FORCE=false
AGENTS=false

while [[ $# -gt 0 ]]; do
    arg="$1"
    shift
    case "$arg" in
        --help)
            usage
            exit 0
            ;;
        --force)
            FORCE=true
            ;;
        --agents)
            AGENTS=true
            ;;
        --agents=*)
            AGENTS=true
            OPT_AGENTS="${arg#*=}"
            ;;
        --runtime|--runtime=*|--docker-image|--docker-image=*|--docker-network|--docker-network=*|\
        --compose-service|--compose-service=*|--compose-project-base|--compose-project-base=*|\
        --test-command|--test-command=*|--project-dir|--project-dir=*|--stubs-dir|--stubs-dir=*)
            name="${arg%%=*}"
            if [[ "$arg" == *=* ]]; then
                value="${arg#*=}"
            elif [[ $# -gt 0 ]]; then
                value="$1"
                shift
            else
                echo "Error: $name requires a value." >&2
                exit 1
            fi
            # --compose-project-base -> OPT_COMPOSE_PROJECT_BASE
            var="OPT_$(echo "${name#--}" | tr 'a-z-' 'A-Z_')"
            [[ -z "$value" ]] || printf -v "$var" '%s' "$value"
            ;;
        *)
            echo "Error: Unknown option '$arg'. Run 'vendor/bin/worktree install --help' for usage." >&2
            exit 1
            ;;
    esac
done

if [[ -n "${OPT_RUNTIME+x}" && " ${VALID_RUNTIMES[*]} " != *" $OPT_RUNTIME "* ]]; then
    echo "Error: Invalid runtime '$OPT_RUNTIME'. Use: native, docker-compose, docker-image" >&2
    exit 1
fi

# Inside Sail's container the project path and git differ from the host's,
# so the hook path written to git config would be wrong.
if [[ "${LARAVEL_SAIL:-}" == 1 ]]; then
    echo "Error: Run the installer on the host, not inside Sail" >&2
    echo "  (vendor/bin/worktree install or php artisan worktree:install, without sail)." >&2
    exit 1
fi

PROJECT_DIR="${OPT_PROJECT_DIR-$(resolve_project_root)}"

SAIL_DETECTED=false
if [[ -n "${OPT_RUNTIME+x}" ]]; then
    RUNTIME_OPT="$OPT_RUNTIME"
elif detect_sail "$PROJECT_DIR"; then
    SAIL_DETECTED=true
    RUNTIME_OPT=docker-image
    OPT_DOCKER_IMAGE="${OPT_DOCKER_IMAGE-$SAIL_IMAGE}"
    OPT_DOCKER_NETWORK="${OPT_DOCKER_NETWORK-$SAIL_NETWORK}"
else
    RUNTIME_OPT=native
fi

if ! STUBS_DIR="${OPT_STUBS_DIR-$(find_stubs_dir "$PROJECT_DIR")}"; then
    echo "Error: Could not locate package stubs directory." >&2
    echo "  Pass --stubs-dir=/path/to/vendor/anthonyiles/worktree-isolation/stubs" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------
echo "Installing worktree isolation..."
echo ""

if [[ "$SAIL_DETECTED" == true ]]; then
    echo "  Detected Laravel Sail: using the docker-image runtime"
fi

# 1. Verify git version
verify_git_version || exit 1

# 2. Create .worktree-isolation.env — the only file this installer writes
# into the project. Everything else runs from vendor/ via vendor/bin/worktree
# (the only Composer "bin"), which dispatches to the sibling scripts.
create_env_config

# 3. Configure git hooks
configure_git_hooks

# 4. Optionally tell AI agents to go through vendor/bin/worktree
if [[ "$AGENTS" == true ]]; then
    if [[ -n "${OPT_AGENTS+x}" ]]; then
        write_agent_instructions "$OPT_AGENTS"
    else
        write_agent_instructions
    fi
fi

echo ""
echo "Worktree isolation installed and activated!"
echo ""
echo "What was done:"
echo "  - Created .worktree-isolation.env (runtime: $RUNTIME_OPT)"
echo "  - Configured git hook.worktree-setup.command/event (local, this clone only)"
echo "    pointing at the vendor copy of the post-checkout hook"
echo ""
echo "Next steps:"
echo "  1. Review .worktree-isolation.env and adjust if needed"
echo "  2. Commit .worktree-isolation.env"
echo "  3. Other engineers just need to run: vendor/bin/worktree install (or php artisan worktree:install for Laravel)"
echo "     once per clone — this activates the hook locally. Worktrees of branches without the"
echo "     committed .worktree-isolation.env are skipped."
echo ""
