{
    "name": "worktree-isolation",
    "image": "mcr.microsoft.com/devcontainers/php:1-8.4-bookworm",
    "features": {
        // Debian's git is too old for config-based hooks (2.54+) and --relative-paths.
        "ghcr.io/devcontainers/features/git:1": {
            "version": "latest"
        }
    },
    "containerEnv": {
        // The image enables Xdebug step debugging, which warns on every php call.
        "XDEBUG_MODE": "off"
    },
    // The image's Yarn apt source has an unavailable signing key, which fails apt-get update.
    "postCreateCommand": "sudo rm -f /etc/apt/sources.list.d/yarn.list && sudo apt-get update && sudo apt-get install -y bats shellcheck && composer install --no-interaction"
}
