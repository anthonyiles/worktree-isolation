{
  "name": "worktree-isolation",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.4-bookworm",

  "features": {
    // Debian's git is too old for config-based hooks (2.54+) and --relative-paths.
    "ghcr.io/devcontainers/features/git:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  // Secrets (e.g. GH_TOKEN) come from a file on the host, outside the repo.
  // initializeCommand creates it empty where it's missing (e.g. Codespaces,
  // which injects its own secrets) so --env-file never fails.
  "initializeCommand": "mkdir -p \"$HOME/.config/devcontainer-secrets\" && touch \"$HOME/.config/devcontainer-secrets/env\"",
  "runArgs": ["--env-file", "${localEnv:HOME}/.config/devcontainer-secrets/env"],

  // Claude Code login, settings and history survive rebuilds. Log in once
  // per container with `claude auth login`: Remote Control needs a full login,
  // not a CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`.
  "mounts": [
    "source=claude-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // The image enables Xdebug step debugging, which warns on every php call.
    "XDEBUG_MODE": "off"
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/claude-rc.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "jetmore.vscode-bats",
        "timonwong.shellcheck"
      ]
    }
  }
}
